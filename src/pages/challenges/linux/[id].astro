---
// src/pages/challenges/linux/[id].astro
import MainLayout from '../../../layouts/MainLayout.astro';
import ChallengeModal from '../../../components/ChallengeModal.astro';
import { parseFrontMatter, parseSteps } from '../../../utils/challenge-parser';
import fs from 'fs';
import path from 'path';
import { marked } from 'marked';

export async function getStaticPaths() {
  const challengesDir = path.join(process.cwd(), 'challenges/linux/retos');
  const entries = fs.readdirSync(challengesDir, { withFileTypes: true });

  const paths = entries
    .filter(entry => entry.isDirectory())
    .map(entry => {
      const readmePath = path.join(challengesDir, entry.name, 'README.md');
      if (fs.existsSync(readmePath)) {
        return { params: { id: entry.name } };
      }
    })
    .filter(Boolean);

  return paths;
}

const { id } = Astro.params;
const filePath = path.join(process.cwd(), 'challenges/linux/retos', id, 'README.md');
const content = fs.readFileSync(filePath, 'utf-8');

const frontMatter = parseFrontMatter(content);
const steps = parseSteps(content);
const htmlContent = marked.parse(content.replace(/^---[\s\S]*?---/, ''));

const title = frontMatter.title || `Linux Challenge ${id}`;
---

<MainLayout title={`${title} - Linux Challenges`}>
  <style is:global>
    .markdown-body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.8;
      color: #e5e7eb;
    }
    .markdown-body h1 {
      font-size: 2rem;
      font-weight: 700;
      color: #f97316;
      margin: 2rem 0 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid #374151;
    }
    .markdown-body h2 {
      font-size: 1.5rem;
      font-weight: 600;
      color: #22d3ee;
      margin: 1.75rem 0 1rem;
      padding-bottom: 0.25rem;
    }
    .markdown-body h3 {
      font-size: 1.25rem;
      font-weight: 600;
      color: #a5f3fc;
      margin: 1.5rem 0 0.75rem;
    }
    .markdown-body p {
      margin: 0.75rem 0;
      color: #d1d5db;
    }
    .markdown-body strong {
      color: #fbbf24;
      font-weight: 600;
    }
    .markdown-body ul, .markdown-body ol {
      margin: 0.75rem 0;
      padding-left: 1.5rem;
      color: #d1d5db;
    }
    .markdown-body li {
      margin: 0.5rem 0;
      list-style-type: disc;
    }
    .markdown-body table {
      width: 100%;
      margin: 1rem 0;
      border-collapse: collapse;
      font-size: 0.9rem;
    }
    .markdown-body th, .markdown-body td {
      padding: 0.75rem;
      border: 1px solid #374151;
      text-align: left;
    }
    .markdown-body th {
      background: rgba(55, 65, 81, 0.5);
      color: #fbbf24;
      font-weight: 600;
    }
    .markdown-body td {
      color: #d1d5db;
    }
    .markdown-body code {
      background: rgba(6, 182, 212, 0.15);
      color: #22d3ee;
      padding: 0.2rem 0.5rem;
      border-radius: 0.375rem;
      font-family: 'SF Mono', Monaco, 'Courier New', monospace;
      font-size: 0.875rem;
    }
    .markdown-body pre {
      background: #0f172a;
      padding: 1rem;
      border-radius: 0.75rem;
      overflow-x: auto;
      margin: 1rem 0;
      border: 1px solid #1e293b;
    }
    .markdown-body pre code {
      background: transparent;
      padding: 0;
      color: #a5b4fc;
    }
  </style>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <div class="mb-6">
        <a href="/challenges/linux" class="text-cyan-400 hover:text-cyan-300">← Volver a Linux Challenges</a>
      </div>

      <article class="bg-slate-800 rounded-lg p-6 border border-slate-700">
        <header class="mb-6">
          <h1 class="text-3xl font-bold text-orange-400 mb-2">{title}</h1>
          <div class="flex items-center gap-4 text-sm text-gray-400">
            <span class="bg-orange-600 px-2 py-1 rounded text-xs">Linux</span>
            <span class="capitalize">{frontMatter.difficulty || 'Medium'}</span>
            <span>{frontMatter.date || 'N/A'}</span>
          </div>
        </header>

        <div class="prose prose-invert max-w-none">
          <div class="markdown-body" set:html={htmlContent} />
        </div>
      </article>

      {steps.length > 0 && (
        <ChallengeModal
          id={id}
          title={title}
          category="linux"
          difficulty={frontMatter.difficulty}
          steps={steps}
          verification={frontMatter.verification}
          learnings={frontMatter.learnings}
        />
      )}
    </div>
  </main>
</MainLayout>
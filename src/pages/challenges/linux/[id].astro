---
// src/pages/challenges/linux/[id].astro
import MainLayout from '../../../layouts/MainLayout.astro';
import ChallengeModal from '../../../components/ChallengeModal.astro';
import { parseFrontMatter, parseSteps } from '../../../utils/challenge-parser';
import fs from 'fs';
import path from 'path';
import { marked } from 'marked';

export async function getStaticPaths() {
  const challengesDir = path.join(process.cwd(), 'challenges/linux/retos');
  const entries = fs.readdirSync(challengesDir, { withFileTypes: true });

  const paths = entries
    .filter(entry => entry.isDirectory())
    .map(entry => {
      const readmePath = path.join(challengesDir, entry.name, 'README.md');
      if (fs.existsSync(readmePath)) {
        return { params: { id: entry.name } };
      }
    })
    .filter(Boolean);

  return paths;
}

const { id } = Astro.params;
const filePath = path.join(process.cwd(), 'challenges/linux/retos', id, 'README.md');
const content = fs.readFileSync(filePath, 'utf-8');

const frontMatter = parseFrontMatter(content);
const steps = parseSteps(content);
const htmlContent = marked.parse(content.replace(/^---[\s\S]*?---/, ''));

const title = frontMatter.title || `Linux Challenge ${id}`;
---

<MainLayout title={`${title} - Linux Challenges`}>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <div class="mb-6">
        <a href="/challenges/linux" class="text-cyan-400 hover:text-cyan-300">← Volver a Linux Challenges</a>
      </div>

      <article class="bg-slate-800 rounded-lg p-6 border border-slate-700">
        <header class="mb-6">
          <h1 class="text-3xl font-bold text-orange-400 mb-2">{title}</h1>
          <div class="flex items-center gap-4 text-sm text-gray-400">
            <span class="bg-orange-600 px-2 py-1 rounded text-xs">Linux</span>
            <span class="capitalize">{frontMatter.difficulty || 'Medium'}</span>
            <span>{frontMatter.date || 'N/A'}</span>
          </div>
        </header>

        <div class="prose prose-invert max-w-none">
          <div set:html={htmlContent} />
        </div>
      </article>

      {steps.length > 0 && (
        <ChallengeModal
          id={id}
          title={title}
          category="linux"
          difficulty={frontMatter.difficulty}
          steps={steps}
          verification={frontMatter.verification}
          learnings={frontMatter.learnings}
        />
      )}
    </div>
  </main>
</MainLayout>
---
// src/pages/challenges/htb/index.astro
import MainLayout from '../../../layouts/MainLayout.astro';
import allChallenges from '../../../data/all-challenges.json';

const challenges = allChallenges.htb;

// Estadísticas
const completed = challenges.filter(c => c.status === 'completed').length;
const inProgress = challenges.filter(c => c.status === 'in_progress').length;
const total = challenges.length;
const percentage = total > 0 ? Math.round((completed / total) * 100) : 0;
---

<MainLayout title="HTB Academy - Hack The Box">
  <div class="container mx-auto px-4 py-8">
    
    <!-- Header -->
    <div class="mb-8">
      <nav class="flex items-center gap-2 text-sm mb-4" style="color: var(--color-text-secondary);">
        <a href="/" class="hover:underline" style="color: var(--color-accent);">Dashboard</a>
        <span>/</span>
        <span>HTB</span>
      </nav>
      
      <div class="flex items-center gap-4 mb-4">
        <span class="text-5xl">🎯</span>
        <div>
          <h1 class="text-3xl font-bold" style="color: var(--color-text);">HTB Academy</h1>
          <p style="color: var(--color-text-secondary);">Hack The Box - Cybersecurity challenges</p>
        </div>
      </div>
    </div>
    
    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <div class="card text-center py-4">
        <div class="text-2xl font-bold" style="color: var(--color-accent);">{total}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">Total</div>
      </div>
      <div class="card text-center py-4">
        <div class="text-2xl font-bold text-green-400">{completed}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">Completados</div>
      </div>
      <div class="card text-center py-4">
        <div class="text-2xl font-bold text-yellow-400">{inProgress}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">En Progreso</div>
      </div>
      <div class="card text-center py-4">
        <div class="text-2xl font-bold" style="color: var(--color-accent);">{percentage}%</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">Progreso</div>
      </div>
    </div>
    
    <!-- Empty state -->
    {challenges.length === 0 && (
      <div class="card text-center py-16">
        <span class="text-6xl mb-4">🎯</span>
        <h2 class="text-2xl font-bold mb-2" style="color: var(--color-text);">
          Próximamente
        </h2>
        <p class="mb-6" style="color: var(--color-text-secondary);">
          Los desafíos de Hack The Box estarán disponibles pronto.
          <br>Comienza con los retos de CTF mientras tanto.
        </p>
        <a href="/challenges/ctf" class="btn btn-primary">
          🚩 Ir a CTF Challenges
        </a>
      </div>
    )}
    
    <!-- Challenges Grid -->
    {challenges.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {challenges.map((challenge: any) => (
          <a 
            href={challenge.path}
            class="card group relative overflow-hidden"
          >
            <div class="pt-6">
              <h3 class="text-lg font-semibold mb-2" style="color: var(--color-text);">
                {challenge.title}
              </h3>
              <p class="text-sm mb-4" style="color: var(--color-text-secondary);">
                {challenge.excerpt || 'Sin descripción'}
              </p>
              <span class="flex items-center gap-1 text-sm font-medium" style="color: var(--color-accent);">
                Ver detalle →
              </span>
            </div>
          </a>
        ))}
      </div>
    )}
    
  </div>
</MainLayout>

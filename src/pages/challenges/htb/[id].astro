---
import fs from 'fs';
import path from 'path';
import ChallengeModal from '../../../components/ChallengeModal.astro';
import { marked } from 'marked';

export async function getStaticPaths() {
  const htbPath = path.join(process.cwd(), 'challenges', 'htb');
  const paths = [];
  
  if (!fs.existsSync(htbPath)) return [];
  
  const files = fs.readdirSync(htbPath).filter(f => f.endsWith('.md'));
  
  files.forEach(file => {
    paths.push({
      params: { id: file.replace('.md', '') }
    });
  });
  
  return paths;
}

interface Step {
  title: string;
  commands?: string[];
  output?: string;
  explanation?: string;
}

function parseFrontMatter(content: string): Record<string, any> {
  const match = content.match(/^---\n([\s\S]*?)\n---/);
  if (!match) return {};
  
  const yaml = match[1];
  const frontMatter: Record<string, any> = {};
  
  yaml.split('\n').forEach(line => {
    const m = line.match(/^(\w+):\s*(.*)$/);
    if (m) {
      let value = m[2].trim().replace(/^["']|["']$/g, '');
      if (value === '') value = '[]';
      try {
        if (value.startsWith('[')) {
          frontMatter[m[1]] = value.replace(/[\[\]]/g, '').split(',').map((v: string) => v.trim().replace(/['"]/g, ''));
        } else if (value.includes(',')) {
          // Handle comma-separated values as arrays
          frontMatter[m[1]] = value.split(',').map((v: string) => v.trim().replace(/['"]/g, ''));
        } else {
          frontMatter[m[1]] = value;
        }
      } catch {
        frontMatter[m[1]] = value;
      }
    }
  });
  
  return frontMatter;
}

function parseSteps(content: string): Step[] {
  const steps: Step[] = [];
  const mainContent = content.replace(/^---[\s\S]*?---/, '');
  
  const solutionSection = mainContent.match(/## 🛠️ Solución([\s\S]*?)(?=## 🚀|## 🔧|## 🎯|$)/);
  if (solutionSection) {
    const stepMatches = solutionSection[1].match(/### Paso \d+: ([^\n]+)\n([\s\S]*?)(?=### Paso \d+:|$)/g);
    if (stepMatches) {
      stepMatches.forEach((step: string) => {
        const titleMatch = step.match(/### Paso \d+: ([^\n]+)/);
        const title = titleMatch ? titleMatch[1] : 'Paso';
        
        const cmdMatch = step.match(/```bash\n([\s\S]*?)```/);
        const cmds = cmdMatch 
          ? cmdMatch[1].split('\n').filter((c: string) => c.trim()).map((c: string) => c.trim())
          : undefined;
        
        const outputMatch = step.match(/Output:\s*\n\n([^`]+)/);
        const output = outputMatch ? outputMatch[1].trim() : undefined;
        
        const explanationMatch = step.split('```')[0].replace(/### Paso \d+: [^\n]+\n/g, '').trim();
        
        steps.push({
          title,
          commands: cmds,
          output,
          explanation: explanationMatch || undefined
        });
      });
    }
  }
  
  if (steps.length === 0) {
    const cmdBlock = mainContent.match(/```bash\n([\s\S]*?)```/);
    if (cmdBlock) {
      const cmds = cmdBlock[1].split('\n')
        .filter((c: string) => c.trim() && !c.trim().startsWith('#'))
        .map((c: string) => c.trim());
      
      if (cmds.length > 0) {
        steps.push({
          title: 'Comandos de Solución',
          commands: cmds
        });
      }
    }
  }
  
  return steps;
}

const { id } = Astro.params as { id: string };
let filePath = '';
let content = '';
let frontMatter: Record<string, any> = {};

const htbPath = path.join(process.cwd(), 'challenges', 'htb');
const mdPath = path.join(htbPath, `${id}.md`);

if (fs.existsSync(mdPath)) {
  filePath = mdPath;
}

if (filePath && fs.existsSync(filePath)) {
  content = fs.readFileSync(filePath, 'utf-8');
  frontMatter = parseFrontMatter(content);
}

const title = frontMatter.title || id;
const cleanTitle = title.replace(/^"\d+:\s*/,'').replace(/"/g,'');
const steps = parseSteps(content);
const htmlContent = marked.parse(content.replace(/^---[\s\S]*?---/, ''));
const categoryColor = 'from-green-500 to-teal-600';
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={cleanTitle} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{cleanTitle} | HTB Challenge</title>
    <style is:global>
      .markdown-body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.8;
        color: #e5e7eb;
      }
      .markdown-body h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #f97316;
        margin: 2rem 0 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #374151;
      }
      .markdown-body h2 {
        font-size: 1.5rem;
        font-weight: 600;
        color: #22d3ee;
        margin: 1.75rem 0 1rem;
        padding-bottom: 0.25rem;
      }
      .markdown-body h3 {
        font-size: 1.25rem;
        font-weight: 600;
        color: #a5f3fc;
        margin: 1.5rem 0 0.75rem;
      }
      .markdown-body p {
        margin: 0.75rem 0;
        color: #d1d5db;
      }
      .markdown-body strong {
        color: #fbbf24;
        font-weight: 600;
      }
      .markdown-body ul, .markdown-body ol {
        margin: 0.75rem 0;
        padding-left: 1.5rem;
        color: #d1d5db;
      }
      .markdown-body li {
        margin: 0.5rem 0;
        list-style-type: disc;
      }
      .markdown-body table {
        width: 100%;
        margin: 1rem 0;
        border-collapse: collapse;
        font-size: 0.9rem;
      }
      .markdown-body th, .markdown-body td {
        padding: 0.75rem;
        border: 1px solid #374151;
        text-align: left;
      }
      .markdown-body th {
        background: rgba(55, 65, 81, 0.5);
        color: #fbbf24;
        font-weight: 600;
      }
      .markdown-body td {
        color: #d1d5db;
      }
      .markdown-body code {
        background: rgba(6, 182, 212, 0.15);
        color: #22d3ee;
        padding: 0.2rem 0.5rem;
        border-radius: 0.375rem;
        font-family: 'SF Mono', Monaco, 'Courier New', monospace;
        font-size: 0.875rem;
      }
      .markdown-body pre {
        background: #0f172a;
        padding: 1rem;
        border-radius: 0.75rem;
        overflow-x: auto;
        margin: 1rem 0;
        border: 1px solid #1e293b;
      }
      .markdown-body pre code {
        background: transparent;
        padding: 0;
        color: #a5b4fc;
      }
    </style>
  </head>
  <body class="bg-dark-bg text-gray-100 min-h-screen">
    <header class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 border-b border-dark-border">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <a href="/challenges/htb" class="flex items-center space-x-3 text-gray-400 hover:text-white transition-colors">
          <span class="text-2xl">←</span>
          <span>Volver a HTB Challenges</span>
        </a>
      </nav>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="flex items-center space-x-4 mb-4">
          <span class={`px-4 py-2 bg-gradient-to-r ${categoryColor} rounded-full text-lg font-bold text-white`}>
            🎯
          </span>
          <span class="px-3 py-1 bg-green-500/20 text-green-400 rounded-full text-sm">✅ Completado</span>
          <span class="px-3 py-1 bg-slate-700 rounded-full text-sm">⭐ {frontMatter.difficulty || 1}</span>
          <span class="px-3 py-1 bg-slate-700 rounded-full text-sm">{frontMatter.platform || 'HTB'}</span>
        </div>
        <h1 class="text-4xl font-bold text-white mb-2">{cleanTitle}</h1>
        <p class="text-gray-400">HTB Challenge</p>
      </div>
    </header>
    
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <article class="prose prose-invert max-w-none">
        <div class="bg-dark-card rounded-xl border border-dark-border p-8">
          {frontMatter.flag && (
            <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-lg">
              <p class="text-red-400 text-sm font-bold mb-2">🏴 Flag</p>
              <code class="text-red-300 font-mono text-lg">{frontMatter.flag}</code>
            </div>
          )}
          
          {frontMatter.tags && frontMatter.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-6">
              {frontMatter.tags.map((tag: string) => (
                <span class="px-3 py-1 bg-green-500/20 text-green-400 rounded-full text-sm">#{tag}</span>
              ))}
            </div>
          )}
          
           <div class="markdown-body" set:html={htmlContent}></div>
        </div>
      </article>

      <div class="mt-8 flex justify-between items-center">
        <a href="/challenges/htb" class="px-6 py-3 bg-slate-700 hover:bg-slate-600 rounded-lg transition-colors">
          ← Volver
        </a>
        <button onclick={`openModal('${id}')`} class="px-6 py-3 bg-gradient-to-r from-green-500 to-teal-600 hover:from-green-600 hover:to-teal-700 rounded-lg transition-all font-medium flex items-center gap-2 shadow-lg shadow-green-500/25">
          <span>📋</span>
          <span>Ver Solución Paso a Paso</span>
        </button>
      </div>
    </main>

    <ChallengeModal 
      id={id} 
      title={cleanTitle} 
      category={frontMatter.category || 'htb'} 
      difficulty={frontMatter.difficulty}
      flag={frontMatter.flag}
      steps={steps}
      verification={['Reto completado', 'Puntuación obtenida']}
    />

    <footer class="border-t border-dark-border mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-center text-gray-500 text-sm">
        <p>Technical Challenges Repository | HTB Challenge</p>
      </div>
    </footer>

    <script>
      function openModal(modalId: string) {
        const modal = document.getElementById(`modal-${modalId}`);
        if (modal) {
          modal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }
      }
      window.openModal = openModal;
    </script>
  </body>
</html>
---
import MainLayout from '../../layouts/MainLayout.astro';
import fs from 'fs';
import path from 'path';

interface Challenge {
  id: string;
  title: string;
  description: string;
  category: string;
  difficulty: number;
  platform: string;
  tags: string[];
}

function parseFrontMatter(content: string) {
  const match = content.match(/^---\n([\s\S]*?)\n---/);
  if (!match) return null;
  
  const yaml = match[1];
  const result: Record<string, any> = {};
  
  yaml.split('\n').forEach(line => {
    const m = line.match(/^(\w+):\s*(.*)$/);
    if (m) {
      let value = m[2].trim().replace(/^["']|["']$/g, '');
      if (value === '') value = '[]';
      try {
        if (value.startsWith('[')) {
          result[m[1]] = value.replace(/[\[\]]/g, '').split(',').map((v: string) => v.trim().replace(/['"]/g, ''));
        } else {
          result[m[1]] = value;
        }
      } catch {
        result[m[1]] = value;
      }
    }
  });
  
  return result;
}

function extractDescription(content: string): string {
  // Remove front matter
  const mainContent = content.replace(/^---\n[\s\S]*?\n---/, '');
  
  // Try to find description after ## Objetivo or similar
  const objectiveMatch = mainContent.match(/## [🎯📖].*?(?:\n\n|\n)(.*?)(?=\n## |\n### |$)/);
  if (objectiveMatch) {
    return objectiveMatch[1].trim().substring(0, 150) + '...';
  }
  
  // Fallback: first paragraph
  const firstPara = mainContent.match(/\n\n([^#\n].*?)(?=\n\n|\n#|$)/);
  if (firstPara) {
    return firstPara[1].trim().substring(0, 150) + '...';
  }
  
  return 'Reto de ciberseguridad en Hack The Box';
}

function getChallenges(): Challenge[] {
  const challenges: Challenge[] = [];
  const htbPath = './challenges/htb';

  if (!fs.existsSync(htbPath)) return challenges;

  // Read all .md files in HTB directory
  const files = fs.readdirSync(htbPath).filter(f => f.endsWith('.md'));
  
  files.forEach(file => {
    const filePath = path.join(htbPath, file);
    try {
      const content = fs.readFileSync(filePath, 'utf-8');
      const fm = parseFrontMatter(content);
      
      if (fm) {
        challenges.push({
          id: file.replace('.md', ''),
          title: fm.title || file.replace('.md', '').replace(/-/g, ' '),
          description: extractDescription(content),
          category: fm.category || 'Academy',
          difficulty: fm.difficulty === 'easy' ? 1 : fm.difficulty === 'medium' ? 2 : fm.difficulty === 'hard' ? 3 : 1,
          platform: fm.platform || 'HTB',
          tags: fm.tags || ['htb']
        });
      }
    } catch (e) {
      console.error(`Error reading ${filePath}:`, e);
    }
  });

  return challenges;
}

const htbChallenges = getChallenges();

const total = htbChallenges.length;
---

<MainLayout title="🎯 HTB Challenges | Ciberseguridad">
  <div style="background: var(--color-bg); color: var(--color-text); min-height: 100vh;">
    <!-- Hero Section -->
    <header style="background: linear-gradient(135deg, var(--color-bg-hover) 0%, var(--color-bg) 100%); border-bottom: 1px solid var(--color-border); padding: 3rem 0;">
      <div style="max-width: 80rem; margin: 0 auto; padding: 0 1rem;">
        <nav style="margin-bottom: 1.5rem;">
          <a href="/" style="color: var(--color-accent); text-decoration: none; font-size: 0.875rem;">← Volver al Dashboard</a>
        </nav>
        
        <div style="text-align: center;">
          <div style="font-size: 4rem; margin-bottom: 1rem;">🎯</div>
          <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--color-text);">
            HTB Challenges
          </h1>
          <p style="font-size: 1.125rem; color: var(--color-text-secondary); max-width: 36rem; margin: 0 auto;">
            Hack The Box - Retos de ciberseguridad y pentesting
          </p>
          <p style="font-size: 1.5rem; font-weight: 700; color: var(--color-accent); margin-top: 1rem;">
            {total} retos disponibles
          </p>
        </div>
      </div>
    </header>

    <!-- Challenges List -->
    <main style="max-width: 80rem; margin: 0 auto; padding: 2rem 1rem 4rem;">
      {htbChallenges.length === 0 ? (
        <div style="text-align: center; padding: 4rem 0;">
          <p style="color: var(--color-text-secondary);">Cargando retos...</p>
        </div>
      ) : (
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
          {htbChallenges.map((challenge) => (
            <a 
              href={`/challenges/htb/${challenge.id}.html`}
              style="background: var(--color-bg-hover); border: 1px solid var(--color-border); border-radius: 1rem; padding: 1.5rem; text-decoration: none; display: block; transition: all 0.3s ease;"
              onmouseenter="this.style.borderColor='var(--color-accent)'; this.style.transform='translateY(-4px)'"
              onmouseleave="this.style.borderColor='var(--color-border)'; this.style.transform='translateY(0)'"
            >
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                <span style="display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; background: rgba(34, 197, 94, 0.1); color: rgb(34, 197, 94); border: 1px solid rgba(34, 197, 94, 0.3);">
                  🎯 HTB
                </span>
                <span style="font-size: 0.875rem;">
                  {'⭐'.repeat(challenge.difficulty)}
                </span>
              </div>
              
              <h3 style="font-size: 1.125rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem;">
                {challenge.title}
              </h3>
              <p style="color: var(--color-text-secondary); font-size: 0.875rem; line-height: 1.5; margin-bottom: 1rem;">
                {challenge.description}
              </p>
              
              <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                {challenge.tags.slice(0, 3).map(tag => (
                  <span style="font-size: 0.75rem; padding: 0.25rem 0.5rem; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 0.25rem; color: var(--color-text-secondary);">
                    #{tag}
                  </span>
                ))}
              </div>
            </a>
          ))}
        </div>
      )}
    </main>
  </div>
</MainLayout>
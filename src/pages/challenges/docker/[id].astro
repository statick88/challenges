---
// src/pages/challenges/docker/[id].astro
import MainLayout from '../../../layouts/MainLayout.astro';
import { parseFrontMatter } from '../../../utils/challenge-parser';
import fs from 'fs';
import path from 'path';
import { marked } from 'marked';

export async function getStaticPaths() {
  const challengesDir = path.join(process.cwd(), 'challenges/docker/challenges');
  const files = fs.readdirSync(challengesDir).filter(f => f.endsWith('.md'));
  
  return files.map(file => ({
    params: { id: file.replace('.md', '') }
  }));
}

const { id } = Astro.params as { id: string };
const filePath = path.join(process.cwd(), 'challenges/docker/challenges', `${id}.md`);
let content = '';
let frontMatter: Record<string, any> = {};

if (fs.existsSync(filePath)) {
  content = fs.readFileSync(filePath, 'utf-8');
  frontMatter = parseFrontMatter(content);
} else {
  frontMatter = { title: `Challenge not found: ${id}` };
  content = '# Challenge Not Found';
}

const htmlContent = marked.parse(content.replace(/^---[\s\S]*?---/, ''));
const title = frontMatter.title || `Docker Challenge ${id}`;
---

<MainLayout title={`${title} - Docker Challenges`}>
  <style is:global>
    .markdown-body { font-family: system-ui; line-height: 1.8; color: #e5e7eb; }
    .markdown-body h1 { font-size: 2rem; font-weight: 700; color: #3b82f6; margin: 2rem 0 1rem; border-bottom: 1px solid #374151; padding-bottom: 0.5rem; }
    .markdown-body h2 { font-size: 1.5rem; font-weight: 600; color: #22d3ee; margin: 1.75rem 0 1rem; }
    .markdown-body h3 { font-size: 1.25rem; font-weight: 600; color: #a5f3fc; margin: 1.5rem 0 0.75rem; }
    .markdown-body p { margin: 0.75rem 0; color: #d1d5db; }
    .markdown-body strong { color: #fbbf24; font-weight: 600; }
    .markdown-body code { background: rgba(6, 182, 212, 0.15); color: #22d3ee; padding: 0.2rem 0.5rem; border-radius: 0.375rem; font-family: monospace; }
    .markdown-body pre { background: #0f172a; padding: 1rem; border-radius: 0.75rem; overflow-x: auto; margin: 1rem 0; border: 1px solid #1e293b; }
    .markdown-body pre code { background: transparent; padding: 0; color: #a5b4fc; }
    .markdown-body ul, .markdown-body ol { margin: 0.75rem 0; padding-left: 1.5rem; color: #d1d5db; }
    .markdown-body li { margin: 0.5rem 0; }
    .markdown-body blockquote { border-left: 4px solid #3b82f6; padding-left: 1rem; margin: 1rem 0; color: #9ca3af; }
  </style>
  
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm mb-6" style="color: var(--color-text-secondary);">
        <a href="/" class="hover:underline" style="color: var(--color-accent);">Dashboard</a>
        <span>/</span>
        <a href="/challenges/docker" class="hover:underline" style="color: var(--color-accent);">Docker</a>
        <span>/</span>
        <span>{title}</span>
      </nav>
      
      <article class="card p-8">
        <header class="mb-6">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-blue-400 font-mono">🐳 Docker</span>
            <span class="text-xs px-2 py-1 rounded bg-blue-500/20 text-blue-400">
              Reto #{id.match(/\d+/)?.[0] || '?'}
            </span>
          </div>
          <h1 class="text-3xl font-bold mb-4" style="color: var(--color-text);">{title}</h1>
          <div class="flex items-center gap-4 text-sm" style="color: var(--color-text-secondary);">
            <span>Dificultad: {frontMatter.difficulty || 'N/A'}</span>
            <span>Fecha: {frontMatter.date || 'N/A'}</span>
          </div>
        </header>
        
        <div class="markdown-body" set:html={htmlContent} />
      </article>
      
      <!-- Navigation -->
      <div class="flex justify-between mt-8">
        <a href="/challenges/docker" class="btn btn-secondary">
          ← Volver a Docker
        </a>
      </div>
    </div>
  </main>
</MainLayout>

---
// src/pages/challenges/devops/index.astro
import MainLayout from '../../../layouts/MainLayout.astro';
import allChallenges from '../../../data/all-challenges.json';

const challenges = allChallenges.devops;

// Estadísticas
const completed = challenges.filter(c => c.status === 'completed').length;
const inProgress = challenges.filter(c => c.status === 'in_progress').length;
const blocked = challenges.filter(c => c.status === 'blocked').length;
const ready = challenges.filter(c => c.status === 'ready').length;
const total = challenges.length;
const percentage = total > 0 ? Math.round((completed / total) * 100) : 0;

// Colores por estado
const statusColors: Record<string, string> = {
  completed: 'bg-green-500/20 text-green-400 border-green-500/30',
  in_progress: 'bg-yellow-500/20 text-yellow-400 border-yellow-500/30',
  blocked: 'bg-red-500/20 text-red-400 border-red-500/30',
  ready: 'bg-blue-500/20 text-blue-400 border-blue-500/30'
};

const statusLabels: Record<string, string> = {
  completed: '✅ Completado',
  in_progress: '🔓 En Progreso',
  blocked: '🔒 Bloqueado',
  ready: '⏳ Listo'
};
---

<MainLayout title="DevOps 100 Days - Automatización">
  <div class="container mx-auto px-4 py-8">
    
    <!-- Header -->
    <div class="mb-8">
      <nav class="flex items-center gap-2 text-sm mb-4" style="color: var(--color-text-secondary);">
        <a href="/" class="hover:underline" style="color: var(--color-accent);">Dashboard</a>
        <span>/</span>
        <span>DevOps</span>
      </nav>
      
      <div class="flex items-center gap-4 mb-4">
        <span class="text-5xl">⚙️</span>
        <div>
          <h1 class="text-3xl font-bold" style="color: var(--color-text);">100 Días de DevOps</h1>
          <p style="color: var(--color-text-secondary);">Retos de automatización e infraestructura</p>
        </div>
      </div>
    </div>
    
    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
      <div class="card text-center py-4">
        <div class="text-2xl font-bold" style="color: var(--color-accent);">{total}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">Total Días</div>
      </div>
      <div class="card text-center py-4">
        <div class="text-2xl font-bold text-green-400">{completed}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">Completados</div>
      </div>
      <div class="card text-center py-4">
        <div class="text-2xl font-bold text-yellow-400">{inProgress}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">En Progreso</div>
      </div>
      <div class="card text-center py-4">
        <div class="text-2xl font-bold text-blue-400">{ready}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">Listos</div>
      </div>
      <div class="card text-center py-4">
        <div class="text-2xl font-bold" style="color: var(--color-accent);">{percentage}%</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">Progreso</div>
      </div>
    </div>
    
    <!-- Progress Bar -->
    <div class="mb-8">
      <div class="progress-bar" style="height: 10px;">
        <div class="progress-bar-fill" style={`width: ${percentage}%; background: linear-gradient(90deg, #a855f7, #ec4899);`}></div>
      </div>
    </div>
    
    <!-- Challenges Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {challenges.map((challenge: any) => (
        <a 
          href={challenge.path}
          class="card group relative overflow-hidden"
        >
          <!-- Status indicator -->
          <div class={`absolute top-0 right-0 px-3 py-1 text-xs font-medium rounded-bl-lg border ${statusColors[challenge.status] || statusColors.ready}`}>
            {statusLabels[challenge.status] || '⏳ Listo'}
          </div>
          
          <!-- Content -->
          <div class="pt-6">
            <!-- Day number -->
            <div class="flex items-center gap-2 mb-2">
              <span class="text-purple-400 font-mono text-sm font-bold">
                Day {String(challenge.day || challenge.id.match(/\d+/)?.[0] || '?').padStart(2, '0')}
              </span>
            </div>
            
            <!-- Title -->
            <h3 class="text-lg font-semibold mb-2 line-clamp-2" style="color: var(--color-text);">
              {challenge.title}
            </h3>
            
            <!-- Excerpt -->
            <p class="text-sm mb-4 line-clamp-3" style="color: var(--color-text-secondary);">
              {challenge.excerpt || 'Sin descripción disponible'}
            </p>
            
            <!-- Footer -->
            <div class="flex items-center justify-between">
              <span class="text-xs" style="color: var(--color-text-muted);">
                {challenge.date || 'Sin fecha'}
              </span>
              <span class="flex items-center gap-1 text-sm font-medium group-hover:translate-x-1 transition-transform" style="color: var(--color-accent);">
                Ver detalle
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
    
  </div>
</MainLayout>

<style>
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>

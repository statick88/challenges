---
// src/components/ChallengeCard.astro
export interface Props {
  title: string;
  category: string;
  difficulty: string;
  status: string;
  date: string;
  href: string;
}

const { title, category, difficulty, status, date, href } = Astro.props;

const difficultyColors = {
  easy: "text-green-400",
  medium: "text-yellow-400",
  hard: "text-red-400"
};

const statusColors = {
  completed: "bg-green-600",
  in_progress: "bg-yellow-600",
  ready: "bg-blue-600"
};
---

<div class="bg-slate-800 p-6 rounded-lg border border-slate-700 hover:border-slate-600 transition-colors">
  <div class="flex justify-between items-start mb-3">
    <h3 class="text-lg font-semibold text-gray-100">{title}</h3>
    <span class={`px-2 py-1 rounded text-xs font-medium ${statusColors[status] || "bg-gray-600"}`}>
      {status}
    </span>
  </div>

  <div class="flex items-center gap-4 text-sm text-gray-400 mb-4">
    <span class="capitalize">{category}</span>
    <span class={difficultyColors[difficulty] || "text-gray-400"}>{difficulty}</span>
    <span>{date}</span>
  </div>

  <a href={href} class="text-cyan-400 hover:text-cyan-300 text-sm font-medium">
    Ver desafío →
  </a>
</div>
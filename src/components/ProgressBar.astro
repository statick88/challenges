---
interface Props {
  percentage: number;
  total: number;
  completed: number;
  showLabel?: boolean;
  height?: string;
}

const { percentage, total, completed, showLabel = true, height = "h-3" } = Astro.props;

<div class={`relative w-full bg-secondary rounded-full ${height} overflow-hidden`}>
  <div 
    class="absolute top-0 left-0 h-full bg-gradient-to-r from-accent to-emerald-400 rounded-full transition-all duration-700 ease-out progress-fill"
    style={`--progress: ${percentage}%`}
  ></div>
</div>

{showLabel && (
  <div class="flex justify-between mt-2 text-sm">
    <span class="text-text">{completed} completed</span>
    <span class="text-muted">{percentage}%</span>
    <span class="text-muted">of {total} total</span>
  </div>
)}

<style>
  .progress-fill {
    animation: progress-fill 1s ease-out forwards;
  }
</style>
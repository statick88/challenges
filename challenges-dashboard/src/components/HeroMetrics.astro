---
import type { ChallengesData } from '../types/challenges.d.ts';

interface Props {
  data: ChallengesData['overview'];
}

const { data } = Astro.props<Props>();

---
<div class="bg-primary rounded-xl p-6 mb-8 fade-in">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Total Challenges -->
    <div class="text-center">
      <div class="animated-counter text-6xl font-bold text-text" data-target={data.totalChallenges}>
        {data.totalChallenges}
      </div>
      <div class="text-muted text-sm mt-2">Total Challenges</div>
    </div>
    
    <!-- Completed -->
    <div class="text-center">
      <div class="animated-counter text-6xl font-bold text-success" data-target={data.completed}>
        {data.completed}
      </div>
      <div class="text-muted text-sm mt-2">Completed</div>
    </div>
    
    <!-- Completion Rate -->
    <div class="text-center">
      <div class="animated-counter text-6xl font-bold text-accent" data-target={data.completionRate}>
        {data.completionRate}%
      </div>
      <div class="text-muted text-sm mt-2">Completion Rate</div>
    </div>
    
    <!-- Streak -->
    <div class="text-center">
      <div class="flex items-center justify-center space-x-2">
        <span class="text-2xl">🔥</span>
        <div class="animated-counter text-6xl font-bold text-warning" data-target={data.streak}>
          {data.streak}
        </div>
      </div>
      <div class="text-muted text-sm mt-2">Day Streak</div>
    </div>
  </div>
  
  <!-- Last Updated -->
  <div class="text-center mt-6 text-muted text-sm">
    Last updated: {new Date(data.lastUpdated).toLocaleDateString('en-US', { 
      year: 'numeric', 
      month: 'long', 
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    })}
  </div>
</div>

<style>
  .animated-counter {
    animation: counter 2s ease-out;
  }
</style>
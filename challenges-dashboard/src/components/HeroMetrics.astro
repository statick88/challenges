---
import type { ChallengesData } from '../types/challenges.d.ts';
import { components, layout, typography, spacing, colors } from '../utils/design-system';

interface Props {
  data: ChallengesData['overview'];
}

const { data } = Astro.props;

// Helper to format large numbers
const formatNumber = (num: number) => new Intl.NumberFormat('en-US').format(num);
---

<div class={`${components.card.base} fade-in`}>
  <div class={`grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 ${spacing.gap.lg}`}>
    <!-- Total Challenges -->
    <div class="text-center">
      <div class={`animated-counter ${typography.size['6xl']} ${typography.weight.bold} ${colors.text.primary}`} data-target={data.totalChallenges} data-testid="total-challenges">
        {formatNumber(data.totalChallenges)}
      </div>
      <div class={`${colors.text.muted} ${typography.size.sm} ${spacing.m.xs}`}>Total Challenges</div>
    </div>
    
    <!-- Completed -->
    <div class="text-center">
      <div class={`animated-counter ${typography.size['6xl']} ${typography.weight.bold} ${colors.success.text}`} data-target={data.completed} data-testid="completed-challenges">
        {formatNumber(data.completed)}
      </div>
      <div class={`${colors.text.muted} ${typography.size.sm} ${spacing.m.xs}`}>Completed</div>
    </div>
    
    <!-- Completion Rate -->
    <div class="text-center">
      <div class={`animated-counter ${typography.size['6xl']} ${typography.weight.bold} ${colors.accent.text}`} data-target={data.completionRate} data-testid="completion-rate">
        {data.completionRate}%
      </div>
      <div class={`${colors.text.muted} ${typography.size.sm} ${spacing.m.xs}`}>Completion Rate</div>
    </div>
    
    <!-- Streak -->
    <div class="text-center">
      <div class={`flex items-center justify-center space-x-2`}>
        <span class={typography.size['2xl']}>🔥</span>
        <div class={`animated-counter ${typography.size['6xl']} ${typography.weight.bold} ${colors.warning.text}`} data-target={data.streak} data-testid="streak-counter">
          {data.streak}
        </div>
      </div>
      <div class={`${colors.text.muted} ${typography.size.sm} ${spacing.m.xs}`}>Day Streak</div>
    </div>
  </div>
  
  <!-- Last Updated -->
  <div class={`text-center ${spacing.m.lg} ${colors.text.muted} ${typography.size.sm}`}>
    Last updated: {new Date(data.lastUpdated).toLocaleDateString('en-US', { 
      year: 'numeric', 
      month: 'long', 
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    })}
  </div>
</div>

<style>
  .animated-counter {
    animation: counter 2s ease-out;
  }
</style>
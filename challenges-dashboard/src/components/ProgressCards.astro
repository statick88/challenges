---
const linuxProgress = 22.2;
const dockerProgress = 20.0;
const devopsProgress = 4.0;

const linuxCompleted = 4;
const dockerCompleted = 1;
const devopsCompleted = 4;

const linuxTotal = 18;
const dockerTotal = 5;
const devopsTotal = 100;

<section class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
  <!-- Linux Card -->
  <div class="bg-secondary rounded-xl p-6">
    <div class="flex items-center mb-6">
      <span class="text-3xl mr-3">🐧</span>
      <h3 class="text-text text-xl font-semibold">Linux Challenges</h3>
    </div>
    
    <div class="mb-4">
      <div class="relative w-full bg-secondary rounded-full h-3 overflow-hidden">
        <div class="absolute top-0 left-0 h-full bg-gradient-to-r from-accent to-accent-400 rounded-full transition-all duration-700 ease-out" style={`width: ${linuxProgress}%`}></div>
      </div>
      <div class="flex justify-between mt-2 text-sm">
        <span class="text-text">{linuxCompleted} completed</span>
        <span class="text-muted">{linuxProgress}%</span>
        <span class="text-muted">of {linuxTotal} total</span>
      </div>
    </div>
    
    <div class="grid grid-cols-3 gap-4 text-center">
      <div>
        <div class="text-2xl font-bold text-text">{linuxCompleted}</div>
        <div class="text-xs text-muted">Completed</div>
      </div>
      <div>
        <div class="text-2xl font-bold text-accent">{linuxProgress}<span class="text-lg">%</span></div>
        <div class="text-xs text-muted">Progress</div>
      </div>
      <div>
        <div class="text-2xl font-bold text-muted">{linuxTotal - linuxCompleted}</div>
        <div class="text-xs text-muted">Remaining</div>
      </div>
    </div>
  </div>
  
  <!-- Docker Card -->
  <div class="bg-secondary rounded-xl p-6">
    <div class="flex items-center mb-6">
      <span class="text-3xl mr-3">🐳</span>
      <h3 class="text-text text-xl font-semibold">Docker Challenges</h3>
    </div>
    
    <div class="mb-4">
      <div class="relative w-full bg-secondary rounded-full h-3 overflow-hidden">
        <div class="absolute top-0 left-0 h-full bg-gradient-to-r from-accent to-accent-400 rounded-full transition-all duration-700 ease-out" style={`width: ${dockerProgress}%`}></div>
      </div>
      <div class="flex justify-between mt-2 text-sm">
        <span class="text-text">{dockerCompleted} completed</span>
        <span class="text-muted">{dockerProgress}%</span>
        <span class="text-muted">of {dockerTotal} total</span>
      </div>
    </div>
    
    <div class="grid grid-cols-3 gap-4 text-center">
      <div>
        <div class="text-2xl font-bold text-text">{dockerCompleted}</div>
        <div class="text-xs text-muted">Completed</div>
      </div>
      <div>
        <div class="text-2xl font-bold text-accent">{dockerProgress}<span class="text-lg">%</span></div>
        <div class="text-xs text-muted">Progress</div>
      </div>
      <div>
        <div class="text-2xl font-bold text-muted">{dockerTotal - dockerCompleted}</div>
        <div class="text-xs text-muted">Remaining</div>
      </div>
    </div>
  </div>
  
  <!-- DevOps Card -->
  <div class="bg-secondary rounded-xl p-6">
    <div class="flex items-center mb-6">
      <span class="text-3xl mr-3">⚙️</span>
      <h3 class="text-text text-xl font-semibold">DevOps Challenges</h3>
    </div>
    
    <div class="mb-4">
      <div class="relative w-full bg-secondary rounded-full h-3 overflow-hidden">
        <div class="absolute top-0 left-0 h-full bg-gradient-to-r from-accent to-accent-400 rounded-full transition-all duration-700 ease-out" style={`width: ${devopsProgress}%`}></div>
      </div>
      <div class="flex justify-between mt-2 text-sm">
        <span class="text-text">{devopsCompleted} completed</span>
        <span class="text-muted">{devopsProgress}%</span>
        <span class="text-muted">of {devopsTotal} total</span>
      </div>
    </div>
    
    <div class="grid grid-cols-3 gap-4 text-center">
      <div>
        <div class="text-2xl font-bold text-text">{devopsCompleted}</div>
        <div class="text-xs text-muted">Completed</div>
      </div>
      <div>
        <div class="text-2xl font-bold text-accent">{devopsProgress}<span class="text-lg">%</span></div>
        <div class="text-xs text-muted">Progress</div>
      </div>
      <div>
        <div class="text-2xl font-bold text-muted">{devopsTotal - devopsCompleted}</div>
        <div class="text-xs text-muted">Remaining</div>
      </div>
    </div>
  </div>
</section>

---
// Analytics Dashboard Component with enhanced features
interface Props {
  showAnalytics?: boolean;
}

const { showAnalytics = false } = Astro.props<Props>();

<div class="analytics-dashboard bg-secondary rounded-xl p-6 mb-8" style={showAnalytics ? 'display: block;' : 'display: none;'}>
  <h3 class="text-text text-xl font-semibold mb-6 flex items-center">
    <span class="text-2xl mr-3">📊</span>
    Analytics Dashboard
  </h3>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Page Views -->
    <div class="bg-primary rounded-lg p-4 text-center">
      <div class="text-3xl font-bold text-accent" id="page-views-count" data-metric="page-views">-</div>
      <div class="text-sm text-muted mt-1">Page Views</div>
    </div>
    
    <!-- Session Duration -->
    <div class="bg-primary rounded-lg p-4 text-center">
      <div class="text-3xl font-bold text-accent" id="session-duration-count" data-metric="session-duration">-</div>
      <div class="text-sm text-muted mt-1">Avg Session</div>
    </div>
    
    <!-- Button Clicks -->
    <div class="bg-primary rounded-lg p-4 text-center">
      <div class="text-3xl font-bold text-accent" id="button-clicks-count" data-metric="button-clicks">-</div>
      <div class="text-sm text-muted mt-1">Button Clicks</div>
    </div>
    
    <!-- Refresh Count -->
    <div class="bg-primary rounded-lg p-4 text-center">
      <div class="text-3xl font-bold text-warning" id="refresh-count" data-metric="refresh-count">-</div>
      <div class="text-sm text-muted mt-1">Data Refreshes</div>
    </div>
  </div>
  
  <!-- Export Options -->
  <div class="mt-6">
    <h4 class="text-lg font-semibold text-text mb-4">Export Analytics</h4>
    <div class="flex justify-center space-x-4">
      <!-- Export PDF -->
      <div class="text-center">
        <button 
          onclick="window.exportProgress('pdf')" 
          class="bg-accent hover:bg-emerald-400 text-primary px-6 py-2 rounded-lg transition-colors">
          <div class="text-2xl mb-2">📄</div>
          <div class="font-medium text-text">Export PDF Report</div>
          <div class="text-sm text-muted">Complete progress analytics</div>
        </button>
      </div>
      
      <!-- Export CSV -->
      <div class="text-center">
        <button 
          onclick="window.exportProgress('csv')" 
          class="bg-warning hover:bg-amber-400 text-primary px-6 py-2 rounded-lg transition-colors">
          <div class="text-2xl mb-2">📊</div>
          <div class="font-medium text-text">Export CSV Data</div>
          <div class="text-sm text-muted">Raw progress data</div>
        </button>
      </div>
      
      <!-- Export JSON -->
      <div class="text-center">
        <button 
          onclick="window.exportProgress('json')" 
          class="bg-secondary hover:bg-accent text-primary px-6 py-2 rounded-lg transition-colors">
          <div class="text-2xl mb-2">📄</div>
          <div class="font-medium text-text">Export JSON Data</div>
          <div class="text-sm text-muted">Machine-readable format</div>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .export-buttons button {
    transition: all 0.2s ease;
  }
  
  .export-buttons button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  }
</style>
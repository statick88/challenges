---
import type { ProgramData } from '../types/challenges';

interface Props {
  program: ProgramData;
}

const { program }: Props = Astro.props;
---

<div class="bg-secondary rounded-xl p-6 hover:bg-opacity-80 transition-colors duration-200">
  <div class="flex items-center mb-6">
    <span class="text-3xl mr-3">{program.icon}</span>
    <h3 class="text-text text-xl font-semibold">{program.name} Challenges</h3>
  </div>

  <!-- Progress Bar -->
  <div class="mb-4">
    <div
      class="relative w-full bg-secondary rounded-full h-3 overflow-hidden border border-accent border-opacity-20"
    >
      <div
        class="absolute top-0 left-0 h-full bg-gradient-to-r from-accent to-emerald-400 rounded-full transition-all duration-700 ease-out"
        style={`width: ${program.percentage}%`}
      >
      </div>
    </div>
    <div class="flex justify-between mt-2 text-sm">
      <span class="text-text">{program.completed} completed</span>
      <span class="text-muted">{program.percentage}%</span>
      <span class="text-muted">of {program.total} total</span>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-3 gap-4 text-center">
    <div class="p-2">
      <div class="text-2xl font-bold text-text">{program.completed}</div>
      <div class="text-xs text-muted">Completed</div>
    </div>
    <div class="p-2">
      <div class="text-2xl font-bold text-accent">
        {program.percentage}<span class="text-lg">%</span>
      </div>
      <div class="text-xs text-muted">Progress</div>
    </div>
    <div class="p-2">
      <div class="text-2xl font-bold text-muted">
        {program.total - program.completed}
      </div>
      <div class="text-xs text-muted">Remaining</div>
    </div>
  </div>

  <!-- Skills Tags -->
  {program.skills.length > 0 && (
    <div class="mt-4 pt-4 border-t border-accent border-opacity-10">
      <p class="text-xs text-muted mb-2">Skills:</p>
      <div class="flex flex-wrap gap-2">
        {program.skills.map((skill) => (
          <span class="inline-block bg-accent bg-opacity-10 text-accent text-xs px-2 py-1 rounded">
            {skill}
          </span>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  /* Subtle hover effect for program cards */
  div:first-child {
    position: relative;
    overflow: hidden;
  }

  div:first-child::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.1),
      transparent
    );
    transition: left 0.5s;
  }

  div:first-child:hover::before {
    left: 100%;
  }
</style>

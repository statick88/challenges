---
import type { ProgramData } from '../types/challenges';
import { components, layout, typography, spacing, radius, colors } from '../utils/design-system';

interface Props {
  program: ProgramData;
}

const { program }: Props = Astro.props;

// Map program names to testid keys
const testIdMap: { [key: string]: string } = {
  'Linux': 'program-linux',
  'Docker': 'program-docker',
  'DevOps': 'program-devops',
};

const programTestId = testIdMap[program.name] || `program-${program.name.toLowerCase()}`;
const completedTestId = `${program.name.toLowerCase()}-completed`;
const totalTestId = `${program.name.toLowerCase()}-total`;
---

<div class={components.card.interactive} data-testid={programTestId}>
  <!-- Header -->
  <div class={`flex items-center ${spacing.m.lg}`}>
    <span class={`${typography.size['3xl']} ${spacing.m.sm}`}>{program.icon}</span>
    <h3 class={`${colors.text.primary} ${typography.size.xl} ${typography.weight.semibold}`}>
      {program.name} Challenges
    </h3>
  </div>

  <!-- Progress Bar Section -->
  <div class={spacing.m.md}>
    <div class={components.progressBar.container} data-testid={`progress-${program.name.toLowerCase()}`}>
      <div
        class={components.progressBar.fill}
        style={`width: ${program.percentage}%`}
      />
    </div>
    <div class={`flex justify-between mt-2 text-sm`}>
      <span class={colors.text.primary} data-testid={completedTestId}>{program.completed} completed</span>
      <span class={colors.text.muted}>{program.percentage}%</span>
      <span class={colors.text.muted}>of <span data-testid={totalTestId}>{program.total}</span> total</span>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class={`grid grid-cols-3 gap-4 text-center`}>
    <div class={components.statsBox.base}>
      <div class={components.statsBox.number}>{program.completed}</div>
      <div class={components.statsBox.label}>Completed</div>
    </div>
    <div class={components.statsBox.base}>
      <div class={`${components.statsBox.number} ${colors.accent.text}`}>
        {program.percentage}<span class={typography.size.lg}>%</span>
      </div>
      <div class={components.statsBox.label}>Progress</div>
    </div>
    <div class={components.statsBox.base}>
      <div class={`${components.statsBox.number} ${colors.text.muted}`}>
        {program.total - program.completed}
      </div>
      <div class={components.statsBox.label}>Remaining</div>
    </div>
  </div>

  <!-- Skills Tags -->
  {program.skills.length > 0 && (
    <div class={`mt-4 pt-4 border-t border-accent border-opacity-10`}>
      <p class={`text-xs text-muted ${spacing.m.xs}`}>Skills:</p>
      <div class={`flex flex-wrap ${spacing.gap.xs}`}>
        {program.skills.map((skill) => (
          <span class={components.skillTag}>
            {skill}
          </span>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  /* Subtle hover effect for program cards */
  div:first-child {
    position: relative;
    overflow: hidden;
  }

  div:first-child::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.1),
      transparent
    );
    transition: left 0.5s;
  }

  div:first-child:hover::before {
    left: 100%;
  }
</style>

---
import type { ChallengesData } from '../types/challenges.d.ts';

interface Props {
  skills: ChallengesData['skills'];
}

const { skills } = Astro.props;

<div class="bg-secondary rounded-xl p-6 mb-8">
  <h3 class="text-text text-xl font-semibold mb-6 flex items-center">
    <span class="text-2xl mr-3">🛠</span>
    Skills Development
  </h3>
  
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
    {skills.map((skill, index) => (
      <div class="bg-primary rounded-lg p-3 text-center slide-up" 
           style={`animation-delay: ${index * 0.03}s`}>
        <div class="text-accent text-sm font-medium">{skill}</div>
        <div class="text-xs text-muted mt-1">In Progress</div>
      </div>
    ))}
  </div>
  
  {skills.length === 0 && (
    <div class="text-center text-muted py-8">
      <span class="text-2xl mb-2 block">🎓</span>
      Skills will appear as you complete challenges
    </div>
  )}
</div>
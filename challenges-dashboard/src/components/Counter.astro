---
interface Props {
  value: number;
  label: string;
  suffix?: string;
  showAnimation?: boolean;
  icon?: string;
}

const { value, label, suffix = "", showAnimation = true, icon } = Astro.props;

const counterClass = showAnimation ? 'animated-counter' : '';

<!-- Animated Counter -->
<div class="text-center">
  {icon && <div class="text-4xl mb-2">{icon}</div>}
  <div class="relative">
    <div class={`text-5xl font-bold text-text ${counterClass}`} 
         data-target={value}>
      {value.toLocaleString()}{suffix}
    </div>
    <div class="text-muted text-sm mt-1">{label}</div>
  </div>
</div>

<style>
  .animated-counter {
    animation: counter 2s ease-out;
  }
</style>

---
import MainLayout from '../layouts/MainLayout.astro';
import HeroMetrics from '../components/HeroMetrics.astro';
import ProgramCard from '../components/ProgramCard.astro';
import { validateChallengesData } from '../utils/validation';

// Load challenges data
const challengesDataModule = await import('../data/challenges.json');
const challengesData = challengesDataModule.default;

// Validate data structure
if (!validateChallengesData(challengesData)) {
  throw new Error('Invalid challenges data structure');
}
---

<MainLayout title="DevOps Challenges Dashboard">
    <main class="max-w-7xl mx-auto px-4 py-8" data-testid="metrics-container">
        <!-- Header -->
        <header class="text-center mb-12 fade-in">
            <h1 class="text-4xl md:text-5xl font-bold text-text mb-4">
                🚀 Technical Challenges Progress
            </h1>
            <p class="text-lg text-muted max-w-2xl mx-auto">
                Track your journey through Linux, Docker, and DevOps challenges. 
                Build skills, maintain streaks, and achieve mastery.
            </p>
        </header>

        <!-- Hero Metrics -->
        <HeroMetrics data={challengesData.overview} />

        <!-- Progress Cards -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8" data-testid="programs-section">
          {Object.entries(challengesData.programs).map(([key, program]) => (
            <ProgramCard program={program} />
          ))}
        </section>

        <!-- Recent Activity Timeline -->
        <section class="bg-secondary rounded-xl p-6 mb-8">
            <h3 class="text-text text-xl font-semibold mb-6 flex items-center">
                <span class="text-2xl mr-3">📊</span>
                Recent Activity
            </h3>
            
            <div class="space-y-3">
                {challengesData.recentActivity.slice(0, 5).map((activity, index) => (
                    <div class="flex items-center bg-primary rounded-lg p-3">
                        <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center mr-4">
                            <span class="text-lg">{activity.icon}</span>
                        </div>
                        <div class="flex-grow">
                            <div class="text-text text-sm font-medium">{activity.activity}</div>
                            <div class="text-xs text-muted">{activity.program}</div>
                        </div>
                        <div class="text-xs text-muted">{index === 0 ? 'Latest' : `${index + 1}h ago`}</div>
                    </div>
                ))}
            </div>
            
            {challengesData.recentActivity.length === 0 && (
                <div class="text-center text-muted py-8">
                    <span class="text-2xl mb-2">🎯</span>
                    No recent activity yet. Start completing challenges!
                </div>
            )}
        </section>

        <!-- Skills Development -->
        <section class="bg-secondary rounded-xl p-6 mb-8">
            <h3 class="text-text text-xl font-semibold mb-6 flex items-center">
                <span class="text-2xl mr-3">🛠️</span>
                Skills Development
            </h3>
            
            <div class="text-center text-muted py-8">
                <span class="text-2xl mb-2">🎓</span>
                Skills will appear as you complete challenges
            </div>
        </section>

        <!-- Export Section -->
        <section class="bg-secondary rounded-xl p-6 mb-8">
            <h3 class="text-text text-xl font-semibold mb-6 flex items-center">
                <span class="text-2xl mr-3">📤</span>
                Export Progress Data
            </h3>
            
            <div class="text-center">
                <button onclick="window.location.reload()" class="bg-accent hover:bg-emerald-400 text-primary px-8 py-3 rounded-lg transition-colors duration-200 transform hover:scale-105">
                    🔄 Refresh Dashboard
                </button>
            </div>
        </section>

        <!-- Footer -->
        <footer class="mt-16 text-center text-muted text-sm">
            <div class="mb-4">
                <div class="flex items-center justify-center space-x-4 mb-2">
                    <span>Built with</span>
                    <span class="text-accent">❤️</span>
                    <span>using</span>
                    <span class="text-accent">Astro</span>
                    <span>+</span>
                    <span class="text-accent">Tailwind CSS</span>
                </div>
                <div class="flex items-center justify-center space-x-4 text-xs">
                    <span>Auto-updated on every push</span>
                    <span>•</span>
                    <span>Real-time progress tracking</span>
                </div>
            </div>
            <div class="text-xs text-muted border-t border-secondary pt-4">
                © 2026 Diego Saavedra • Technical Challenges Dashboard
                <br>
                <span class="inline-block mt-2">
                    Last updated: {new Date(challengesData.lastUpdated).toLocaleDateString('en-US', { 
                        year: 'numeric', 
                        month: 'long', 
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    })}
                </span>
            </div>
        </footer>
    </main>

    <!-- Scripts -->
    <script>
        import { animateAllCounters } from '../utils/animations';

        document.addEventListener('DOMContentLoaded', () => {
            console.log('🚀 Challenges Dashboard loaded successfully!');
            
            // Simple refresh function
            window.refreshDashboard = function() {
                console.log('🔄 Refreshing dashboard...');
                window.location.reload();
            };
            
            // Keyboard shortcuts
            document.addEventListener('keydown', (e) => {
                // Ctrl/Cmd + R for refresh
                if ((e.ctrlKey || e.metaKey) && e.key === 'r') {
                    e.preventDefault();
                    window.refreshDashboard();
                }
                // Ctrl/Cmd + Shift + D for theme toggle
                if ((e.ctrlKey || e.metaKey) && e.shiftKey === 'D') {
                    e.preventDefault();
                    // Theme toggle functionality would go here
                }
            });
            
            // Animate counters on load using shared utility
            animateAllCounters('main', '.animated-counter');
        });
    </script>
</MainLayout>
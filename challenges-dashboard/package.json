{
  "name": "challenges-dashboard",
  "type": "module",
  "version": "1.0.0",
  "description": "Interactive dashboard for technical challenges progress",
  "scripts": {
    "dev": "node scripts/generate-challenges-data.js && astro dev",
    "start": "astro dev",
    "build": "node scripts/generate-challenges-data.js && astro build",
    "preview": "astro preview",
    "parse-data": "node scripts/generate-challenges-data.js",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.0",
    "astro": "^5.17.1",
    "puppeteer": "^24.36.1",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^20.0.0",
    "@vitest/ui": "^4.0.18",
    "happy-dom": "^20.4.0",
    "playwright": "^1.58.0",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.12.0",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "astro",
    "tailwindcss",
    "dashboard",
    "challenges",
    "devops"
  ],
  "author": "Diego Saavedra",
  "license": "MIT"
}

---
import MainLayout from '../../layouts/MainLayout.astro';
import ChallengeModal from '../../components/ChallengeModal.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { parseFrontMatter, parseSteps } from '../../utils/challenge-parser';
import allChallenges from '../../data/all-challenges.json';
import fs from 'fs';
import path from 'path';
import { marked } from 'marked';
import type { Step } from '../../types/challenges';

export async function getStaticPaths() {
  const challengesDir = path.join(process.cwd(), '..', 'challenges', 'linux', 'retos');
  if (!fs.existsSync(challengesDir)) return [];
  const entries = fs.readdirSync(challengesDir, { withFileTypes: true });

  const paths = entries
    .filter(entry => entry.isDirectory())
    .map(entry => {
      const readmePath = path.join(challengesDir, entry.name, 'README.md');
      if (fs.existsSync(readmePath)) {
        return { params: { id: entry.name } };
      }
    })
    .filter(Boolean);

  return paths;
}

const { id } = Astro.params as { id: string };
const filePath = path.join(process.cwd(), '..', 'challenges', 'linux', 'retos', id, 'README.md');
let content = '';
let frontMatter: Record<string, any> = {};
let steps: Step[] = [];

if (fs.existsSync(filePath)) {
  content = fs.readFileSync(filePath, 'utf-8');
  frontMatter = parseFrontMatter(content);
  steps = parseSteps(content);
} else {
  frontMatter = { title: `Challenge not found: ${id}` };
  content = '# Challenge Not Found\n\nThe requested challenge could not be found.';
  steps = [];
}
const htmlContent = marked.parse(content.replace(/^---[\s\S]*?---/, ''));

const title = frontMatter.title || `Linux Challenge ${id}`;

const challenges = allChallenges.linux;
const currentIndex = challenges.findIndex((c: any) => c.id === id);
const prevChallenge = currentIndex > 0 ? challenges[currentIndex - 1] : null;
const nextChallenge = currentIndex < challenges.length - 1 ? challenges[currentIndex + 1] : null;
const challengeNum = id.match(/\d+/)?.[0] || '?';
---

<MainLayout title={`${title} - Linux Challenges`}>
  <style is:global>
    .markdown-body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.8;
      color: #e5e7eb;
    }
    .markdown-body h1 {
      font-size: 2rem;
      font-weight: 700;
      color: #f97316;
      margin: 2rem 0 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid #374151;
    }
    .markdown-body h2 {
      font-size: 1.5rem;
      font-weight: 600;
      color: #22d3ee;
      margin: 1.75rem 0 1rem;
      padding-bottom: 0.25rem;
    }
    .markdown-body h3 {
      font-size: 1.25rem;
      font-weight: 600;
      color: #a5f3fc;
      margin: 1.5rem 0 0.75rem;
    }
    .markdown-body p {
      margin: 0.75rem 0;
      color: #d1d5db;
    }
    .markdown-body strong {
      color: #fbbf24;
      font-weight: 600;
    }
    .markdown-body ul, .markdown-body ol {
      margin: 0.75rem 0;
      padding-left: 1.5rem;
      color: #d1d5db;
    }
    .markdown-body li {
      margin: 0.5rem 0;
      list-style-type: disc;
    }
    .markdown-body table {
      width: 100%;
      margin: 1rem 0;
      border-collapse: collapse;
      font-size: 0.9rem;
    }
    .markdown-body th, .markdown-body td {
      padding: 0.75rem;
      border: 1px solid #374151;
      text-align: left;
    }
    .markdown-body th {
      background: rgba(55, 65, 81, 0.5);
      color: #fbbf24;
      font-weight: 600;
    }
    .markdown-body td {
      color: #d1d5db;
    }
    .markdown-body code {
      background: rgba(6, 182, 212, 0.15);
      color: #22d3ee;
      padding: 0.2rem 0.5rem;
      border-radius: 0.375rem;
      font-family: 'SF Mono', Monaco, 'Courier New', monospace;
      font-size: 0.875rem;
    }
    .markdown-body pre {
      background: #0f172a;
      padding: 1rem;
      border-radius: 0.75rem;
      overflow-x: auto;
      margin: 1rem 0;
      border: 1px solid #1e293b;
    }
    .markdown-body pre code {
      background: transparent;
      padding: 0;
      color: #a5b4fc;
    }
  </style>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <Breadcrumb items={[
        { label: 'Challenges', href: '/challenges' },
        { label: 'Linux', href: '/challenges/linux' },
        { label: title }
      ]} />
      
      <article class="bg-slate-800 rounded-lg p-6 border border-slate-700">
        <header class="mb-6">
          <h1 class="text-3xl font-bold text-orange-400 mb-2">{title}</h1>
          <div class="flex items-center gap-4 text-sm text-gray-400">
            <span class="bg-orange-600 px-2 py-1 rounded text-xs">Linux #{challengeNum}</span>
            <span class="capitalize">{frontMatter.difficulty || 'Medium'}</span>
            <span>{frontMatter.date || 'N/A'}</span>
          </div>
        </header>

        <div class="prose prose-invert max-w-none">
          <div class="markdown-body" set:html={htmlContent} />
        </div>
      </article>

      {steps.length > 0 && (
        <ChallengeModal
          id={id}
          title={title}
          category="linux"
          difficulty={frontMatter.difficulty}
          steps={steps}
          verification={frontMatter.verification}
          learnings={frontMatter.learnings}
        />
      )}

      <!-- Navigation -->
      <div class="nav-buttons">
        {prevChallenge ? (
          <a href={prevChallenge.path} class="nav-btn prev">
            <span class="nav-icon">←</span>
            <span class="nav-content">
              <span class="nav-label">Anterior</span>
              <span class="nav-title">#{prevChallenge.id.match(/\d+/)?.[0] || '?'} {prevChallenge.title.length > 40 ? prevChallenge.title.slice(0, 40) + '...' : prevChallenge.title}</span>
            </span>
          </a>
        ) : (
          <span class="nav-btn disabled prev">
            <span class="nav-icon">←</span>
            <span class="nav-content">
              <span class="nav-label">Anterior</span>
              <span class="nav-title">No hay reto anterior</span>
            </span>
          </span>
        )}
        
        <a href="/challenges/linux/" class="nav-btn home">
          <span class="nav-icon">🐧</span>
          <span class="nav-content">
            <span class="nav-label">Volver</span>
            <span class="nav-title">Todos los Retos</span>
          </span>
        </a>
        
        {nextChallenge ? (
          <a href={nextChallenge.path} class="nav-btn next">
            <span class="nav-content">
              <span class="nav-label">Siguiente</span>
              <span class="nav-title">#{nextChallenge.id.match(/\d+/)?.[0] || '?'} {nextChallenge.title.length > 40 ? nextChallenge.title.slice(0, 40) + '...' : nextChallenge.title}</span>
            </span>
            <span class="nav-icon">→</span>
          </a>
        ) : (
          <span class="nav-btn disabled next">
            <span class="nav-content">
              <span class="nav-label">Siguiente</span>
              <span class="nav-title">No hay reto siguiente</span>
            </span>
            <span class="nav-icon">→</span>
          </span>
        )}
      </div>
    </div>
  </main>
</MainLayout>

<style>
  .nav-buttons {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .nav-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(71, 85, 105, 0.3);
    border-radius: 0.75rem;
    text-decoration: none;
    transition: all 0.2s ease;
    flex: 1;
    min-width: 200px;
    max-width: 280px;
  }

  .nav-btn:hover:not(.disabled) {
    background: rgba(249, 115, 22, 0.1);
    border-color: rgba(249, 115, 22, 0.3);
    transform: translateY(-2px);
  }

  .nav-btn.disabled {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  .nav-btn.prev {
    text-align: left;
  }

  .nav-btn.next {
    text-align: right;
    justify-content: flex-end;
  }

  .nav-btn.home {
    justify-content: center;
    max-width: 200px;
  }

  .nav-icon {
    font-size: 1.25rem;
    color: #f97316;
  }

  .nav-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-label {
    font-size: 0.7rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nav-title {
    font-size: 0.875rem;
    color: #e2e8f0;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .nav-buttons {
      flex-direction: column;
    }
    .nav-btn {
      max-width: 100%;
    }
  }
</style>

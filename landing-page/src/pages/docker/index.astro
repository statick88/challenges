---
import MainLayout from '../../layouts/MainLayout.astro';
import allChallenges from '../../data/all-challenges.json';

interface DockerChallenge {
  id: string;
  title: string;
  status: string;
  difficulty: string;
  skills?: string[];
  path: string;
  timeEstimate?: string;
  date?: string;
  scenario?: string;
}

const challenges = (allChallenges.docker || []) as DockerChallenge[];

// Estadísticas avanzadas
const completed = challenges.filter(c => c.status === 'completed').length;
const inProgress = challenges.filter(c => c.status === 'in_progress').length;
const blocked = challenges.filter(c => c.status === 'blocked').length;
const ready = challenges.filter(c => c.status === 'ready').length;
const total = challenges.length;
const percentage = total > 0 ? Math.round((completed / total) * 100) : 0;

// Análisis de conceptos Docker
const conceptCounts: { [key: string]: number } = challenges.reduce((acc: { [key: string]: number }, c: DockerChallenge) => {
  if (c.skills) {
    c.skills.forEach((skill: string) => {
      acc[skill] = (acc[skill] || 0) + 1;
    });
  }
  return acc;
}, {});

interface ConceptProgress {
  concept: string;
  total: number;
  mastered: number;
  percentage: number;
}

const conceptProgress: ConceptProgress[] = Object.entries(conceptCounts).map(([concept, total]): ConceptProgress => {
  const mastered = challenges.filter((c: DockerChallenge) => 
    c.skills && c.skills.includes(concept) && c.status === 'completed'
  ).length;
  return { concept, total, mastered, percentage: Math.round((mastered / total) * 100) };
});

// Best practices checklist por challenge
const getProductionReadinessChecklist = (challenge: DockerChallenge) => {
  const baseChecklist = [
    { item: 'Imagen optimizada (multi-stage build)', completed: challenge.id.includes('optimiz') || challenge.id.includes('size') || challenge.status === 'completed' },
    { item: 'Seguridad de usuario no-root', completed: challenge.id.includes('security') || challenge.status === 'completed' },
    { item: 'Healthcheck implementado', completed: challenge.id.includes('health') || challenge.status === 'completed' },
    { item: 'Variables de entorno externalizadas', completed: challenge.id.includes('env') || challenge.status === 'completed' },
    { item: 'Volúmenes persistentes', completed: challenge.id.includes('volume') || challenge.status === 'completed' },
    { item: 'Network isolation configurada', completed: challenge.id.includes('network') || challenge.status === 'completed' },
    { item: 'Logs estructurados', completed: challenge.id.includes('log') || challenge.status === 'completed' },
    { item: 'Resource limits definidos', completed: challenge.id.includes('limit') || challenge.status === 'completed' }
  ];
  
  return baseChecklist;
};

const statusColors = {
  completed: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40',
  in_progress: 'bg-amber-500/20 text-amber-400 border-amber-500/40',
  blocked: 'bg-rose-500/20 text-rose-400 border-rose-500/40',
  ready: 'bg-sky-500/20 text-sky-400 border-sky-500/40'
};

const statusLabels = {
  completed: 'Completado',
  in_progress: 'En Progreso',
  blocked: 'Bloqueado',
  ready: 'Pendiente'
};

const statusIcons = {
  completed: '✓',
  in_progress: '◐',
  blocked: '⊘',
  ready: '○'
};

const difficultyConfig = {
  easy: { stars: '⭐', color: 'text-emerald-400 bg-emerald-500/10', label: 'Fácil' },
  medium: { stars: '⭐⭐', color: 'text-amber-400 bg-amber-500/10', label: 'Medio' },
  hard: { stars: '⭐⭐⭐', color: 'text-rose-400 bg-rose-500/10', label: 'Difícil' }
};

const skillColors = [
  'bg-blue-500/20 text-blue-300 border-blue-500/30',
  'bg-cyan-500/20 text-cyan-300 border-cyan-500/30',
  'bg-indigo-500/20 text-indigo-300 border-indigo-500/30',
  'bg-sky-500/20 text-sky-300 border-sky-500/30',
  'bg-teal-500/20 text-teal-300 border-teal-500/30'
];
---

<MainLayout title="Docker Challenges - Containerización">
  <div class="container mx-auto px-4 py-8">
    
    <!-- Header -->
    <div class="mb-8">
      <nav class="flex items-center gap-2 text-sm mb-4" style="color: var(--color-text-secondary);">
        <a href="/challenges/" class="hover:underline" style="color: var(--color-accent);">Dashboard</a>
        <span>/</span>
        <span>Docker</span>
      </nav>
      
      <div class="flex items-center gap-4 mb-4">
        <span class="text-5xl">🐳</span>
        <div>
          <h1 class="text-3xl font-bold" style="color: var(--color-text);">Docker Challenges</h1>
          <p style="color: var(--color-text-secondary);">Desafíos de contenerización y Docker</p>
        </div>
      </div>
    </div>
    
    <!-- Stats Overview Cards -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
      <div class="card text-center py-4">
        <div class="text-2xl font-bold" style="color: var(--color-accent);">{total}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">Total</div>
      </div>
      <div class="card text-center py-4">
        <div class="text-2xl font-bold text-emerald-400">{completed}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">Completados</div>
      </div>
      <div class="card text-center py-4">
        <div class="text-2xl font-bold text-amber-400">{inProgress}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">En Progreso</div>
      </div>
      <div class="card text-center py-4">
        <div class="text-2xl font-bold text-rose-400">{blocked}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">Bloqueados</div>
      </div>
      <div class="card text-center py-4">
        <div class="text-2xl font-bold" style="color: var(--color-accent);">{percentage}%</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">Progreso</div>
      </div>
    </div>
    
    <!-- Progress Bar -->
    <div class="mb-6">
      <div class="progress-bar" style="height: 10px;">
        <div class="progress-bar-fill" style={`width: ${percentage}%; background: linear-gradient(90deg, #3b82f6, #06b6d4);`}></div>
      </div>
    </div>
    
    <!-- Quick Actions -->
    <div class="mb-8 flex gap-4 flex-wrap">
      <button class="action-btn" onclick="document.getElementById('architecture-view').scrollIntoView({behavior: 'smooth'})">
        🏗️ Ver Arquitectura de Contenedores
      </button>
      <button class="action-btn" onclick="document.getElementById('production-readiness').scrollIntoView({behavior: 'smooth'})">
        🚀 Checklist de Producción
      </button>
      <button class="action-btn" onclick="exportDockerProgress()">
        📊 Exportar Progreso Docker
      </button>
    </div>
    
    <!-- Docker Architecture Overview -->
    <div class="mb-8" id="architecture-view">
      <h2 class="text-xl font-bold mb-4" style="color: var(--color-text);">
        🏗️ Arquitectura de Contenedores
      </h2>
      <div class="architecture-diagram">
        <div class="arch-layer">
          <div class="arch-label">Aplicación</div>
          <div class="arch-boxes">
            {challenges.filter(c => c.status === 'completed').map((c, idx) => (
              <div class="arch-box completed" title={c.title}>
                <span class="arch-icon">📦</span>
                <span class="arch-text">App {idx + 1}</span>
              </div>
            )).slice(0, 4)}
          </div>
        </div>
        <div class="arch-arrow">↓</div>
        <div class="arch-layer">
          <div class="arch-label">Docker Engine</div>
          <div class="arch-boxes">
            <div class="arch-box engine">
              <span class="arch-icon">🐳</span>
              <span class="arch-text">Docker</span>
            </div>
          </div>
        </div>
        <div class="arch-arrow">↓</div>
        <div class="arch-layer">
          <div class="arch-label">Sistema Operativo</div>
          <div class="arch-boxes">
            <div class="arch-box os">
              <span class="arch-icon">💻</span>
              <span class="arch-text">Linux Kernel</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Production Readiness Score -->
    <div class="mb-8" id="production-readiness">
      <h2 class="text-xl font-bold mb-4" style="color: var(--color-text);">
        🚀 Estado de Preparación para Producción
      </h2>
      <div class="production-score-grid">
        {challenges.map((challenge) => {
          const checklist = getProductionReadinessChecklist(challenge);
          const completedItems = checklist.filter(item => item.completed).length;
          const readinessPercentage = Math.round((completedItems / checklist.length) * 100);
          
          return (
            <div class="production-card">
              <div class="production-header">
                <h3 class="production-title">{challenge.title}</h3>
                <div class="production-score">{readinessPercentage}%</div>
              </div>
              <div class="production-progress">
                <div class="progress-bar" style="height: 6px;">
                  <div class="progress-bar-fill" style={`width: ${readinessPercentage}%; background: linear-gradient(90deg, #3b82f6, #06b6d4);`}></div>
                </div>
              </div>
              <div class="production-checklist">
                {checklist.map((item, idx) => (
                  <div class="checklist-item">
                    <span class="checklist-check">{item.completed ? '✓' : '○'}</span>
                    <span class="checklist-text">{item.item}</span>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>
    
    <!-- Filter Bar -->
    <div class="filter-bar flex flex-wrap gap-2 mb-8">
      <button class="filter-btn active" data-filter="all" data-category="docker">
        Todos ({total})
      </button>
      <button class="filter-btn" data-filter="completed" data-category="docker">
        Completados ✓ ({completed})
      </button>
      <button class="filter-btn" data-filter="in_progress" data-category="docker">
        En Progreso ◐ ({inProgress})
      </button>
      <button class="filter-btn" data-filter="blocked" data-category="docker">
        Bloqueados ⊘ ({blocked})
      </button>
      <button class="filter-btn" data-filter="ready" data-category="docker">
        Pendientes ○ ({ready})
      </button>
    </div>
    
    <!-- Challenges Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="challenges-grid">
      {challenges.map((challenge: DockerChallenge) => {
        const diff = difficultyConfig[challenge.difficulty as keyof typeof difficultyConfig] || difficultyConfig.medium;
        const statusColor = statusColors[challenge.status as keyof typeof statusColors] || statusColors.ready;
        const statusLabel = statusLabels[challenge.status as keyof typeof statusLabels] || 'Pendiente';
        const statusIcon = statusIcons[challenge.status as keyof typeof statusIcons] || '○';
        const challengeNum = challenge.id.match(/\d+/)?.[0] || '?';
        const isCompleted = challenge.status === 'completed';
        
        return (
          <div 
            class="challenge-card group cursor-pointer" 
            data-status={challenge.status}
            data-challenge-path={challenge.path}
            data-challenge-title={challenge.title}
            data-challenge-completed={isCompleted ? 'true' : 'false'}
            onclick="openChallengeModal(this)"
          >
            <!-- Header with number and status -->
            <div class="challenge-card-header">
              <div class="flex items-center gap-2">
                <span class="challenge-number">Reto #{challengeNum}</span>
                <span class={`difficulty-badge ${diff.color}`}>
                  {diff.stars} {diff.label}
                </span>
                <span class="production-badge" title="Best Practices">
                  🏆
                </span>
              </div>
              <span class={`status-badge ${statusColor}`}>
                <span class="status-icon">{statusIcon}</span>
                {statusLabel}
              </span>
            </div>
            
            <!-- Title -->
            <h3 class="challenge-title">
              {challenge.title}
            </h3>
            
            <!-- Scenario -->
            {challenge.scenario && (
              <p class="challenge-scenario">
                {challenge.scenario}
              </p>
            )}
            
            <!-- Skills -->
            {challenge.skills && challenge.skills.length > 0 && (
              <div class="challenge-skills">
                {challenge.skills.slice(0, 4).map((skill: string, idx: number) => (
                  <span class={`skill-tag ${skillColors[idx % skillColors.length]}`}>
                    {skill}
                  </span>
                ))}
              </div>
            )}
            
            <!-- Production Readiness Mini -->
            <div class="production-mini">
              <div class="mini-label">Producción</div>
              <div class="mini-stats">
                {getProductionReadinessChecklist(challenge).filter(item => item.completed).length}/8 listo
              </div>
            </div>
            
            <!-- Footer -->
            <div class="challenge-footer">
              <div class="flex items-center gap-3 text-xs" style="color: var(--color-text-muted);">
                {challenge.timeEstimate && (
                  <span class="flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    {challenge.timeEstimate}
                  </span>
                )}
                <span>{challenge.date || 'Sin fecha'}</span>
              </div>
              
              <span class="view-solution-btn group-hover:scale-105">
                Ver Detalles
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </div>
        );
      })}
    </div>
    
    <!-- Empty state -->
    {challenges.length === 0 && (
      <div class="card text-center py-12">
        <span class="text-4xl mb-4">📭</span>
        <p style="color: var(--color-text-secondary);">No hay desafíos disponibles</p>
      </div>
    )}
    
  </div>
  
  <!-- Challenge Modal -->
  <div id="challenge-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/80" onclick="closeChallengeModal()"></div>
    <div class="absolute inset-4 md:inset-8 lg:inset-12 bg-slate-900 rounded-xl overflow-hidden flex flex-col">
      <div class="flex items-center justify-between p-4 border-b border-slate-700 bg-slate-800">
        <h2 id="modal-title" class="text-xl font-bold text-white">Challenge</h2>
        <button onclick="closeChallengeModal()" class="p-2 hover:bg-slate-700 rounded-lg transition-colors">
          <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="flex-1 overflow-hidden relative">
        <iframe id="challenge-iframe" class="w-full h-full border-0" src=""></iframe>
        <a id="solution-link" href="#" class="hidden absolute bottom-6 right-6 bg-emerald-600 hover:bg-emerald-500 text-white px-6 py-3 rounded-lg font-semibold shadow-lg transition-all hover:scale-105 flex items-center gap-2">
          <span>Ver Solución Completa</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</MainLayout>

<script define:vars={{ total, completed, inProgress, blocked, ready, percentage, conceptProgress }}>
  function exportDockerProgress() {
    const data = {
      totalChallenges: total,
      completed: completed,
      inProgress: inProgress,
      blocked: blocked,
      ready: ready,
      percentage: percentage,
      concepts: conceptProgress,
      timestamp: new Date().toISOString()
    };
    
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `docker-progress-${new Date().toISOString().split('T')[0]}.json`;
    a.click();
    URL.revokeObjectURL(url);
  }
</script>

<script>
  function openChallengeModal(card) {
    const modal = document.getElementById('challenge-modal');
    const iframe = document.getElementById('challenge-iframe');
    const title = document.getElementById('modal-title');
    const solutionLink = document.getElementById('solution-link');
    
    const path = card.getAttribute('data-challenge-path');
    const challengeTitle = card.getAttribute('data-challenge-title');
    const isCompleted = card.getAttribute('data-challenge-completed') === 'true';
    
    title.textContent = challengeTitle;
    iframe.src = path + '/';
    
    if (isCompleted) {
      solutionLink.href = path + '/';
      solutionLink.classList.remove('hidden');
    } else {
      solutionLink.classList.add('hidden');
    }
    
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeChallengeModal() {
    const modal = document.getElementById('challenge-modal');
    const iframe = document.getElementById('challenge-iframe');
    
    modal.classList.add('hidden');
    iframe.src = '';
    document.body.style.overflow = '';
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeChallengeModal();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.challenge-card');
    
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        const filter = btn.getAttribute('data-filter');
        
        cards.forEach(card => {
          const status = card.getAttribute('data-status');
          if (filter === 'all' || status === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  });
</script>

<style>
  .challenge-card {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.9) 100%);
    border: 1px solid rgba(71, 85, 105, 0.3);
    border-radius: 1rem;
    padding: 1.25rem;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: relative;
  }

  .challenge-card:hover {
    border-color: rgba(59, 130, 246, 0.5);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px -12px rgba(59, 130, 246, 0.25);
  }

  .challenge-card.hidden {
    display: none;
  }

  .challenge-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .challenge-number {
    font-family: SF Mono, Monaco, 'Courier New', monospace;
    font-size: 0.875rem;
    font-weight: 700;
    color: #3b82f6;
  }

  .difficulty-badge {
    font-size: 0.7rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    font-weight: 500;
  }

  .production-badge {
    font-size: 0.8rem;
    color: #fbbf24;
    cursor: help;
  }

  .status-badge {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.7rem;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    border: 1px solid;
    font-weight: 500;
    white-space: nowrap;
  }

  .status-icon {
    font-size: 0.625rem;
  }

  .challenge-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #f1f5f9;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .challenge-scenario {
    font-size: 0.8rem;
    color: #94a3b8;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  .challenge-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .skill-tag {
    font-size: 0.65rem;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    border: 1px solid;
    font-weight: 500;
    text-transform: lowercase;
  }

  .production-mini {
    padding: 0.5rem;
    background: rgba(59, 130, 246, 0.05);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 0.375rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
  }

  .mini-label {
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .mini-stats {
    color: #3b82f6;
    font-weight: 600;
  }

  .challenge-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(71, 85, 105, 0.3);
    margin-top: auto;
  }

  .view-solution-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #3b82f6;
    padding: 0.5rem 0.875rem;
    background: rgba(59, 130, 246, 0.1);
    border-radius: 0.5rem;
    transition: all 0.2s ease;
  }

  .view-solution-btn:hover {
    background: rgba(59, 130, 246, 0.2);
  }

  .filter-btn {
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    background: rgba(30, 41, 59, 0.8);
    color: #94a3b8;
    border: 1px solid rgba(71, 85, 105, 0.3);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    background: rgba(51, 65, 85, 0.8);
    color: #e2e8f0;
  }

  .filter-btn.active {
    background: rgba(59, 130, 246, 0.2);
    color: #3b82f6;
    border-color: rgba(59, 130, 246, 0.5);
  }

  .action-btn {
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.3);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .action-btn:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: rgba(59, 130, 246, 0.5);
  }

  /* Architecture Diagram Styles */
  .architecture-diagram {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(71, 85, 105, 0.3);
    border-radius: 1rem;
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .arch-layer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .arch-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: 0.5rem;
  }

  .arch-boxes {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }


---
import MainLayout from '../../layouts/MainLayout.astro';
import ChallengeModal from '../../components/ChallengeModal.astro';
import { parseFrontMatter, parseSteps } from '../../utils/challenge-parser';
import allChallenges from '../../data/all-challenges.json';
import fs from 'fs';
import path from 'path';
import { marked } from 'marked';

export async function getStaticPaths() {
  const challengesDir = path.join(process.cwd(), '..', 'challenges', 'ctf');
  const paths: { params: { slug: string } }[] = [];

  if (!fs.existsSync(challengesDir)) {
    return [];
  }

  function scanDirectory(dir: string, prefix = ''): void {
    const entries = fs.readdirSync(dir, { withFileTypes: true });

    for (const entry of entries) {
      if (entry.isDirectory()) {
        const subDir = path.join(dir, entry.name);
        const readmePath = path.join(subDir, 'README.md');
        const slug = prefix ? `${prefix}/${entry.name}` : entry.name;

        if (fs.existsSync(readmePath)) {
          paths.push({ params: { slug } });
        }
        scanDirectory(subDir, slug);
      } else if (entry.isFile() && entry.name.endsWith('.md') && entry.name !== 'README.md') {
        const slug = prefix ? `${prefix}/${entry.name.replace('.md', '')}` : entry.name.replace('.md', '');
        paths.push({ params: { slug } });
      }
    }
  }

  scanDirectory(challengesDir);
  return paths;
}

const { slug } = Astro.params as { slug: string };
const slugParts = slug.split('/');
const fileName = slugParts[slugParts.length - 1];
const challengesDir = path.join(process.cwd(), '..', 'challenges', 'ctf');

let filePath;
if (slugParts.length === 1) {
  const dirPath = path.join(challengesDir, fileName);
  const readmePath = path.join(dirPath, 'README.md');
  const mdPath = path.join(challengesDir, `${fileName}.md`);

  if (fs.existsSync(readmePath)) {
    filePath = readmePath;
  } else if (fs.existsSync(mdPath)) {
    filePath = mdPath;
  } else {
    throw new Error(`File not found for slug: ${slug}`);
  }
} else {
  const dirPath = path.join(challengesDir, ...slugParts.slice(0, -1));
  const readmePath = path.join(dirPath, 'README.md');
  const mdPath = path.join(dirPath, `${fileName}.md`);

  if (fs.existsSync(readmePath)) {
    filePath = readmePath;
  } else if (fs.existsSync(mdPath)) {
    filePath = mdPath;
  } else {
    throw new Error(`File not found for slug: ${slug}`);
  }
}

const content = fs.readFileSync(filePath, 'utf-8');
const frontMatter = parseFrontMatter(content);
const steps = parseSteps(content);
const mainContent = content.replace(/^---[\s\S]*?---/, '');
const htmlContent = marked.parse(mainContent);

const title = frontMatter.title || `CTF Challenge ${slug}`;

const challenges = allChallenges.ctf;
const currentIndex = challenges.findIndex((c: any) => c.path === `/challenges/ctf/${slug}`);
const prevChallenge = currentIndex > 0 ? challenges[currentIndex - 1] : null;
const nextChallenge = currentIndex < challenges.length - 1 ? challenges[currentIndex + 1] : null;
---

<MainLayout title={`${title} - CTF Challenges`}>
  <style is:global>
    .markdown-body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.8;
      color: #e5e7eb;
    }
    .markdown-body h1 {
      font-size: 2rem;
      font-weight: 700;
      color: #f97316;
      margin: 2rem 0 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid #374151;
    }
    .markdown-body h2 {
      font-size: 1.5rem;
      font-weight: 600;
      color: #22d3ee;
      margin: 1.75rem 0 1rem;
      padding-bottom: 0.25rem;
    }
    .markdown-body h3 {
      font-size: 1.25rem;
      font-weight: 600;
      color: #a5f3fc;
      margin: 1.5rem 0 0.75rem;
    }
    .markdown-body p {
      margin: 0.75rem 0;
      color: #d1d5db;
    }
    .markdown-body strong {
      color: #fbbf24;
      font-weight: 600;
    }
    .markdown-body ul, .markdown-body ol {
      margin: 0.75rem 0;
      padding-left: 1.5rem;
      color: #d1d5db;
    }
    .markdown-body li {
      margin: 0.5rem 0;
      list-style-type: disc;
    }
    .markdown-body ol li {
      list-style-type: decimal;
    }
    .markdown-body table {
      width: 100%;
      margin: 1rem 0;
      border-collapse: collapse;
      font-size: 0.9rem;
    }
    .markdown-body th, .markdown-body td {
      padding: 0.75rem;
      border: 1px solid #374151;
      text-align: left;
    }
    .markdown-body th {
      background: rgba(55, 65, 81, 0.5);
      color: #fbbf24;
      font-weight: 600;
    }
    .markdown-body td {
      color: #d1d5db;
    }
    .markdown-body code {
      background: rgba(6, 182, 212, 0.15);
      color: #22d3ee;
      padding: 0.2rem 0.5rem;
      border-radius: 0.375rem;
      font-family: 'SF Mono', Monaco, 'Courier New', monospace;
      font-size: 0.875rem;
    }
    .markdown-body pre {
      background: #0f172a;
      padding: 1rem;
      border-radius: 0.75rem;
      overflow-x: auto;
      margin: 1rem 0;
      border: 1px solid #1e293b;
    }
    .markdown-body pre code {
      background: transparent;
      padding: 0;
      color: #a5b4fc;
    }
    .markdown-body blockquote {
      border-left: 4px solid #6366f1;
      padding: 0.5rem 1rem;
      margin: 1rem 0;
      background: rgba(99, 102, 241, 0.1);
      border-radius: 0 0.5rem 0.5rem 0;
    }
    .markdown-body hr {
      border: none;
      border-top: 1px solid #374151;
      margin: 2rem 0;
    }
    .markdown-body a {
      color: #60a5fa;
      text-decoration: underline;
    }
    .markdown-body a:hover {
      color: #93bbfd;
    }
  </style>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <div class="mb-6">
        <a href="/challenges" class="text-cyan-400 hover:text-cyan-300">← Volver al Dashboard</a>
      </div>

      <article class="bg-slate-800 rounded-lg p-6 border border-slate-700">
        <header class="mb-6">
          <h1 class="text-3xl font-bold text-orange-400 mb-2">{title}</h1>
          <div class="flex items-center gap-4 text-sm text-gray-400">
            <span class="bg-purple-600 px-2 py-1 rounded text-xs">CTF</span>
            <span class="capitalize">{frontMatter.difficulty || 'Medium'}</span>
            <span>{frontMatter.date || 'N/A'}</span>
            {frontMatter.platform && <span>{frontMatter.platform}</span>}
          </div>
        </header>

        <div class="prose prose-invert max-w-none">
          <div class="markdown-body" set:html={htmlContent} />
        </div>
      </article>

      {steps.length > 0 && (
        <ChallengeModal
          id={slug}
          title={title}
          category="ctf"
          difficulty={frontMatter.difficulty}
          flag={frontMatter.flag}
          steps={steps}
          verification={frontMatter.verification}
          learnings={frontMatter.learnings}
        />
      )}

      <!-- Navigation -->
      <div class="nav-buttons">
        {prevChallenge ? (
          <a href={prevChallenge.path} class="nav-btn prev">
            <span class="nav-icon">←</span>
            <span class="nav-content">
              <span class="nav-label">Anterior</span>
              <span class="nav-title">{prevChallenge.title.length > 40 ? prevChallenge.title.slice(0, 40) + '...' : prevChallenge.title}</span>
            </span>
          </a>
        ) : (
          <span class="nav-btn disabled prev">
            <span class="nav-icon">←</span>
            <span class="nav-content">
              <span class="nav-label">Anterior</span>
              <span class="nav-title">No hay reto anterior</span>
            </span>
          </span>
        )}
        
        <a href="/challenges/ctf/" class="nav-btn home">
          <span class="nav-icon">🚩</span>
          <span class="nav-content">
            <span class="nav-label">Volver</span>
            <span class="nav-title">Todos los Retos</span>
          </span>
        </a>
        
        {nextChallenge ? (
          <a href={nextChallenge.path} class="nav-btn next">
            <span class="nav-content">
              <span class="nav-label">Siguiente</span>
              <span class="nav-title">{nextChallenge.title.length > 40 ? nextChallenge.title.slice(0, 40) + '...' : nextChallenge.title}</span>
            </span>
            <span class="nav-icon">→</span>
          </a>
        ) : (
          <span class="nav-btn disabled next">
            <span class="nav-content">
              <span class="nav-label">Siguiente</span>
              <span class="nav-title">No hay reto siguiente</span>
            </span>
            <span class="nav-icon">→</span>
          </span>
        )}
      </div>
    </div>
  </main>
</MainLayout>

<style>
  .nav-buttons {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .nav-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(71, 85, 105, 0.3);
    border-radius: 0.75rem;
    text-decoration: none;
    transition: all 0.2s ease;
    flex: 1;
    min-width: 200px;
    max-width: 280px;
  }

  .nav-btn:hover:not(.disabled) {
    background: rgba(34, 197, 94, 0.1);
    border-color: rgba(34, 197, 94, 0.3);
    transform: translateY(-2px);
  }

  .nav-btn.disabled {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  .nav-btn.prev {
    text-align: left;
  }

  .nav-btn.next {
    text-align: right;
    justify-content: flex-end;
  }

  .nav-btn.home {
    justify-content: center;
    max-width: 200px;
  }

  .nav-icon {
    font-size: 1.25rem;
    color: #22c55e;
  }

  .nav-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-label {
    font-size: 0.7rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nav-title {
    font-size: 0.875rem;
    color: #e2e8f0;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .nav-buttons {
      flex-direction: column;
    }
    .nav-btn {
      max-width: 100%;
    }
  }
</style>

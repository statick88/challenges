---
import MainLayout from '../layouts/MainLayout.astro';
import challengesData from '../data/challenges.json';
import { formatDate, calculateProgramStats } from '../utils/dashboard-utils';

const { overview, programs, recentActivity } = challengesData;
const { blockedCount, inProgressCount, readyCount } = calculateProgramStats(programs);
---

<MainLayout title="Tech Challenges Dashboard">
  <div class="dashboard">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <div class="hero-badge">🎯 <span data-i18n="hero.badge">Plataforma de Aprendizaje</span></div>
        <h1 class="hero-title">
          <span data-i18n="hero.title.line1">Domina Linux, Docker,</span><br />
          <span class="gradient-text" data-i18n="hero.title.line2">DevOps & Security</span>
        </h1>
        <p class="hero-subtitle" data-i18n="hero.subtitle">
          Plataforma interactiva con 70+ desafíos prácticos. 
          Aprende haciendo, no solo leyendo.
        </p>
        <div class="hero-stats">
          <div class="hero-stat">
            <span class="hero-stat-number">{overview.completed}</span>
            <span class="hero-stat-label" data-i18n="hero.stat.completed">Completados</span>
          </div>
          <div class="hero-stat-divider"></div>
          <div class="hero-stat">
            <span class="hero-stat-number">{overview.completionRate}%</span>
            <span class="hero-stat-label" data-i18n="hero.stat.progress">Progreso</span>
          </div>
          <div class="hero-stat-divider"></div>
          <div class="hero-stat">
            <span class="hero-stat-number">{overview.totalChallenges}</span>
            <span class="hero-stat-label" data-i18n="hero.stat.challenges">Desafíos</span>
          </div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="floating-card card-1">
          <span class="floating-icon">🐧</span>
          <span class="floating-label">Linux</span>
        </div>
        <div class="floating-card card-2">
          <span class="floating-icon">🐳</span>
          <span class="floating-label">Docker</span>
        </div>
        <div class="floating-card card-3">
          <span class="floating-icon">🚀</span>
          <span class="floating-label">DevOps</span>
        </div>
        <div class="floating-card card-4">
          <span class="floating-icon">🔒</span>
          <span class="floating-label">Security</span>
        </div>
      </div>
    </section>

    <!-- Progress Overview -->
    <section class="progress-section">
      <div class="progress-header">
        <h2 data-i18n="progress.title">Progreso General</h2>
        <span class="progress-percentage">{overview.completionRate}%</span>
      </div>
      <div class="progress-track">
        <div class="progress-fill" style={`width: ${overview.completionRate}%`}></div>
        <div class="progress-glow" style={`width: ${overview.completionRate}%`}></div>
      </div>
      <div class="progress-stats">
        <div class="progress-stat completed">
          <span class="dot"></span>
          <span>{overview.completed} <span data-i18n="progress.completed">completados</span></span>
        </div>
        <div class="progress-stat in-progress">
          <span class="dot"></span>
          <span>{inProgressCount + readyCount} <span data-i18n="progress.in_progress">en progreso</span></span>
        </div>
        <div class="progress-stat blocked">
          <span class="dot"></span>
          <span>{blockedCount} <span data-i18n="progress.blocked">bloqueados</span></span>
        </div>
      </div>
    </section>

    <!-- Programs Grid -->
    <section class="programs-section">
      <div class="section-header">
        <h2 data-i18n="programs.title">Programas de Aprendizaje</h2>
        <p data-i18n="programs.subtitle">Selecciona un programa para ver sus desafíos</p>
      </div>
      
      <div class="programs-grid">
        {Object.entries(programs).map(([key, program]) => (
          <a href={(program as any).path} class="program-card" data-program={key}>
            <div class="program-header">
              <span class="program-icon">{(program as any).icon}</span>
              <div class="program-progress">
                <svg viewBox="0 0 36 36" class="progress-ring">
                  <path class="progress-ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                  <path class="progress-ring-fill" stroke-dasharray={`${(program as any).percentage}, 100`} d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                </svg>
                <span class="progress-text">{(program as any).percentage}%</span>
              </div>
            </div>
            
            <h3 class="program-title" data-i18n-program={key}>{(program as any).name}</h3>
            <p class="program-description" data-i18n-program-desc={key}>{(program as any).description}</p>
            
            <div class="program-stats">
              <div class="program-stat">
                <span class="program-stat-value">{(program as any).completed}</span>
                <span class="program-stat-label" data-i18n="programs.completed">Completados</span>
              </div>
              <div class="program-stat-divider"></div>
              <div class="program-stat">
                <span class="program-stat-value">{(program as any).total}</span>
                <span class="program-stat-label" data-i18n="programs.total">Total</span>
              </div>
            </div>
            
            <div class="program-footer">
              <span data-i18n="programs.view">Ver desafíos</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Certifications Section -->
    <section class="cert-section">
      <div class="section-header">
        <h2 data-i18n="cert.title">Certificaciones Obtenidas</h2>
        <p data-i18n="cert.subtitle">Reconocimientos oficiales de tu progreso</p>
      </div>
      
      <div class="cert-card">
        <div class="cert-badge">100%</div>
        <div class="cert-content">
          <div class="cert-icon">🐳</div>
          <div class="cert-info">
            <h3 data-i18n="cert.docker.title">Docker Certification</h3>
            <p class="cert-platform" data-i18n="cert.docker.platform">KodeKloud Engineer</p>
            <div class="cert-meta">
              <span class="cert-date">📅 18 Feb 2026</span>
              <span class="cert-challenges">✓ 9/9 <span data-i18n="cert.challenges">Challenges</span></span>
            </div>
          </div>
        </div>
        <a href="https://engineer.kodekloud.com/certificate-verification/86476a89-ea7b-4e3a-a901-85cec28a00ca" 
           target="_blank" 
           rel="noopener noreferrer" 
           class="cert-verify-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
          <span data-i18n="cert.verify">Verificar certificado</span>
        </a>
      </div>
    </section>

    <!-- Recent Activity -->
    <section class="activity-section">
      <div class="section-header">
        <h2 data-i18n="activity.title">Actividad Reciente</h2>
        <p data-i18n="activity.subtitle">Últimos desafíos completados</p>
      </div>
      
      <div class="activity-list">
        {recentActivity.slice(0, 5).map((activity: any) => (
          <div class="activity-item">
            <div class="activity-icon">{activity.icon}</div>
            <div class="activity-content">
              <span class="activity-title">{activity.activity}</span>
              <span class="activity-program">{activity.program}</span>
            </div>
            <div class="activity-badge completed">✓</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Quick Stats -->
    <section class="quick-stats">
      <div class="quick-stat">
        <div class="quick-stat-icon">🐧</div>
        <div class="quick-stat-value">{(programs as any).linux?.completed ?? 0}</div>
        <div class="quick-stat-label">Linux</div>
      </div>
      <div class="quick-stat">
        <div class="quick-stat-icon">🐳</div>
        <div class="quick-stat-value">{(programs as any).docker?.completed ?? 0}</div>
        <div class="quick-stat-label">Docker</div>
      </div>
      <div class="quick-stat">
        <div class="quick-stat-icon">⚙️</div>
        <div class="quick-stat-value">{(programs as any).devops?.completed ?? 0}</div>
        <div class="quick-stat-label">DevOps</div>
      </div>
      <div class="quick-stat">
        <div class="quick-stat-icon">🚩</div>
        <div class="quick-stat-value">{(programs as any).ctf?.completed ?? 0}</div>
        <div class="quick-stat-label">CTF</div>
      </div>
      <div class="quick-stat">
        <div class="quick-stat-icon">🎯</div>
        <div class="quick-stat-value">{(programs as any).htb?.completed ?? 0}</div>
        <div class="quick-stat-label">HTB</div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="dashboard-footer">
      <p>
        <span data-i18n="footer.update">Última actualización</span>: {formatDate(challengesData.lastUpdated)} • 
        <a href="https://github.com/statick88" target="_blank" rel="noopener noreferrer">@statick88</a>
      </p>
    </footer>
  </div>
</MainLayout>

<style>
  .dashboard {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
  }

  /* Hero Section */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    margin-bottom: 4rem;
    padding: 2rem 0;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: linear-gradient(135deg, rgba(76, 128, 204, 0.2), rgba(59, 130, 246, 0.1));
    border: 1px solid rgba(76, 128, 204, 0.3);
    border-radius: 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin: 0 0 1.5rem 0;
    color: var(--color-text);
  }

  .gradient-text {
    background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #06b6d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .hero-stat {
    text-align: center;
  }

  .hero-stat-number {
    display: block;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .hero-stat-label {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .hero-stat-divider {
    width: 1px;
    height: 3rem;
    background: var(--color-border);
  }

  .hero-visual {
    position: relative;
    height: 400px;
  }

  .floating-card {
    position: absolute;
    padding: 1.5rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    animation: float 6s ease-in-out infinite;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  .floating-icon {
    font-size: 1.5rem;
  }

  .floating-label {
    font-weight: 600;
    color: var(--color-text);
  }

  .card-1 { top: 10%; left: 10%; animation-delay: 0s; }
  .card-2 { top: 30%; right: 5%; animation-delay: 1s; }
  .card-3 { bottom: 30%; left: 5%; animation-delay: 2s; }
  .card-4 { bottom: 10%; right: 15%; animation-delay: 3s; }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }

  /* Progress Section */
  .progress-section {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 2rem;
    margin-bottom: 3rem;
  }

  .progress-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .progress-header h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .progress-percentage {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .progress-track {
    position: relative;
    height: 12px;
    background: var(--color-border);
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6);
    border-radius: 6px;
    transition: width 1s ease;
  }

  .progress-glow {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    border-radius: 6px;
    animation: shimmer 2s infinite;
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  .progress-stats {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .progress-stat {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .progress-stat .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .progress-stat.completed .dot { background: #22c55e; }
  .progress-stat.in-progress .dot { background: #f59e0b; }
  .progress-stat.blocked .dot { background: #ef4444; }

  /* Section Header */
  .section-header {
    margin-bottom: 2rem;
  }

  .section-header h2 {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.5rem 0;
  }

  .section-header p {
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Programs Grid */
  .programs-section {
    margin-bottom: 3rem;
  }

  .programs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .program-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 1.5rem;
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .program-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  .program-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .program-icon {
    font-size: 2.5rem;
  }

  .program-progress {
    position: relative;
    width: 50px;
    height: 50px;
  }

  .progress-ring {
    transform: rotate(-90deg);
    width: 100%;
    height: 100%;
  }

  .progress-ring-bg {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 3;
  }

  .progress-ring-fill {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 3;
    stroke-linecap: round;
    transition: stroke-dasharray 0.5s ease;
  }

  .progress-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .program-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.5rem 0;
  }

  .program-description {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0 0 1.5rem 0;
    flex-grow: 1;
  }

  .program-stats {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .program-stat {
    flex: 1;
    text-align: center;
  }

  .program-stat-value {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .program-stat-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .program-stat-divider {
    width: 1px;
    height: 2rem;
    background: var(--color-border);
  }

  .program-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-accent);
    font-weight: 500;
    font-size: 0.875rem;
  }

  .program-footer svg {
    transition: transform 0.2s ease;
  }

  .program-card:hover .program-footer svg {
    transform: translateX(4px);
  }

  /* Certification Section */
  .cert-section {
    margin-bottom: 3rem;
  }

  .cert-card {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 1rem;
    padding: 2rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cert-badge {
    background: linear-gradient(135deg, #22c55e, #16a34a);
    color: white;
    padding: 0.5rem 1.5rem;
    border-radius: 2rem;
    font-weight: 700;
    font-size: 0.875rem;
  }

  .cert-content {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex: 1;
    min-width: 250px;
  }

  .cert-icon {
    font-size: 3rem;
  }

  .cert-info h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.25rem 0;
  }

  .cert-platform {
    color: var(--color-text-secondary);
    margin: 0 0 0.75rem 0;
  }

  .cert-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .cert-verify-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: white;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .cert-verify-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(59, 130, 246, 0.3);
  }

  /* Activity Section */
  .activity-section {
    margin-bottom: 3rem;
  }

  .activity-list {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    overflow: hidden;
  }

  .activity-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.2s ease;
  }

  .activity-item:last-child {
    border-bottom: none;
  }

  .activity-item:hover {
    background: var(--color-bg-hover);
  }

  .activity-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(76, 128, 204, 0.2);
    border-radius: 50%;
    font-size: 1.25rem;
  }

  .activity-content {
    flex: 1;
  }

  .activity-title {
    display: block;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .activity-program {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: capitalize;
  }

  .activity-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .activity-badge.completed {
    background: rgba(34, 197, 94, 0.2);
    color: #22c55e;
  }

  /* Quick Stats */
  .quick-stats {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .quick-stat {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.5rem 1rem;
    text-align: center;
    transition: all 0.2s ease;
  }

  .quick-stat:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .quick-stat-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .quick-stat-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.25rem;
  }

  .quick-stat-label {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  /* Footer */
  .dashboard-footer {
    text-align: center;
    padding: 2rem 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .dashboard-footer a {
    color: var(--color-accent);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-visual {
      display: none;
    }

    .hero-stats {
      justify-content: center;
    }

    .quick-stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.5rem;
    }

    .hero-stats {
      flex-direction: column;
      gap: 1rem;
    }

    .hero-stat-divider {
      display: none;
    }

    .quick-stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .cert-card {
      flex-direction: column;
      text-align: center;
    }

    .cert-content {
      flex-direction: column;
    }
  }
</style>

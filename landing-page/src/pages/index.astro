---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
import challengesData from '../data/challenges.json';

const { overview, programs, recentActivity, ctfCategories } = challengesData;

// Configuración de colores por programa
const programColors: Record<string, { bg: string; border: string; icon: string }> = {
  linux: { bg: 'bg-gradient-to-br from-orange-500/20 to-red-600/20', border: 'border-orange-500/30', icon: 'text-orange-400' },
  docker: { bg: 'bg-gradient-to-br from-blue-500/20 to-cyan-600/20', border: 'border-blue-500/30', icon: 'text-blue-400' },
  devops: { bg: 'bg-gradient-to-br from-purple-500/20 to-pink-600/20', border: 'border-purple-500/30', icon: 'text-purple-400' },
  ctf: { bg: 'bg-gradient-to-br from-green-500/20 to-emerald-600/20', border: 'border-green-500/30', icon: 'text-green-400' },
  htb: { bg: 'bg-gradient-to-br from-teal-500/20 to-cyan-600/20', border: 'border-teal-500/30', icon: 'text-teal-400' },
};

// Formatear fecha
function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('es-ES', { 
    day: 'numeric', 
    month: 'short', 
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
}

// Calcular estadísticas adicionales
const blockedCount = Object.values(programs).reduce((acc: number, p: any) => acc + (p.blocked || 0), 0);
const inProgressCount = Object.values(programs).reduce((acc: number, p: any) => acc + (p.inProgress || 0), 0);
const readyCount = Object.values(programs).reduce((acc: number, p: any) => acc + (p.ready || 0), 0);
---

<MainLayout title="Dashboard de Desafíos Técnicos">
  <div class="container mx-auto px-4 py-8">
    
    <!-- Hero Section -->
    <section class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-4" style="color: var(--color-text);">
        🚀 Dashboard de Desafíos Técnicos
      </h1>
      <p class="text-lg max-w-2xl mx-auto" style="color: var(--color-text-secondary);">
        Plataforma interactiva de aprendizaje: Linux, Docker, DevOps y CTF. 
        Última actualización: {formatDate(challengesData.lastUpdated)}
      </p>
    </section>
    
    <!-- Stats Overview -->
    <section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      <div class="card stat-card">
        <div class="stat-value">{overview.totalChallenges}</div>
        <div class="stat-label">Desafíos Totales</div>
      </div>
      <div class="card stat-card">
        <div class="stat-value" style="color: #1a7f37;">{overview.completed}</div>
        <div class="stat-label">Completados</div>
      </div>
      <div class="card stat-card">
        <div class="stat-value" style="color: #f59e0b;">{inProgressCount + readyCount}</div>
        <div class="stat-label">En Progreso</div>
      </div>
      <div class="card stat-card">
        <div class="stat-value" style="color: #dc2626;">{blockedCount}</div>
        <div class="stat-label">Bloqueados</div>
      </div>
    </section>
    
    <!-- Progress Bar -->
    <section class="mb-12">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-medium" style="color: var(--color-text-secondary);">Progreso Total</span>
        <span class="text-sm font-bold" style="color: var(--color-accent);">{overview.completionRate}%</span>
      </div>
      <div class="progress-bar">
        <div class="progress-bar-fill" style={`width: ${overview.completionRate}%`}></div>
      </div>
    </section>
    
    <!-- Programs Grid -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-6" style="color: var(--color-text);">
        📊 Programas de Aprendizaje
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6">
        {Object.entries(programs).map(([key, program]) => (
          <a 
            href={(program as any).path}
            class="card group relative overflow-hidden"
          >
            <!-- Gradient Background -->
            <div class={`absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 ${programColors[key]?.bg || ''}`}></div>
            
            <!-- Content -->
            <div class="relative z-10">
              <!-- Header -->
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl">{(program as any).icon}</span>
                <span class={`badge badge-${key}`}>
                  {(program as any).percentage}%
                </span>
              </div>
              
              <!-- Title -->
              <h3 class="text-xl font-bold mb-2" style="color: var(--color-text);">
                {(program as any).name}
              </h3>
              
              <!-- Description -->
              <p class="text-sm mb-4 line-clamp-2" style="color: var(--color-text-secondary);">
                {(program as any).description}
              </p>
              
              <!-- Progress -->
              <div class="mb-3">
                <div class="flex items-center justify-between text-xs mb-1" style="color: var(--color-text-muted);">
                  <span>{(program as any).completed} / {(program as any).total} completados</span>
                </div>
                <div class="progress-bar" style="height: 6px;">
                  <div 
                    class="progress-bar-fill" 
                    style={`width: ${(program as any).percentage}%;`}
                  ></div>
                </div>
              </div>
              
              <!-- Status badges -->
              {((program as any).blocked > 0 || (program as any).inProgress > 0 || (program as any).ready > 0) && (
                <div class="flex flex-wrap gap-1 mb-3">
                  {(program as any).blocked > 0 && (
                    <span class="text-xs px-2 py-0.5 rounded bg-red-500/20 text-red-400">
                      {(program as any).blocked} bloqueados
                    </span>
                  )}
                  {(program as any).inProgress > 0 && (
                    <span class="text-xs px-2 py-0.5 rounded bg-yellow-500/20 text-yellow-400">
                      {(program as any).inProgress} en progreso
                    </span>
                  )}
                  {(program as any).ready > 0 && (
                    <span class="text-xs px-2 py-0.5 rounded bg-blue-500/20 text-blue-400">
                      {(program as any).ready} listos
                    </span>
                  )}
                </div>
              )}
              
              <!-- Link -->
              <div class="flex items-center gap-2 text-sm font-medium" style="color: var(--color-accent);">
                <span>Ver desafíos</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
    
    <!-- CTF Categories -->
    {ctfCategories && ctfCategories.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold mb-6" style="color: var(--color-text);">
          🚩 Categorías CTF
        </h2>
        
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4">
          {ctfCategories.map((cat: any) => (
            <div class="card text-center py-4">
              <div class="text-2xl mb-2">
                {cat.name === 'forensics' ? '🔍' : 
                 cat.name === 'crypto' ? '🔐' :
                 cat.name === 'web' ? '🌐' :
                 cat.name === 'pwn' ? '💥' :
                 cat.name === 'reversing' ? '🔄' :
                 cat.name === 'misc' ? '📦' :
                 cat.name === 'academy' ? '🎓' :
                 cat.name === 'ctf' ? '🚩' : '📄'}
              </div>
              <div class="text-sm font-bold capitalize" style="color: var(--color-text);">{cat.name}</div>
              <div class="text-xs" style="color: var(--color-text-secondary);">
                {cat.completed}/{cat.total}
              </div>
              <div class="progress-bar mt-2" style="height: 4px;">
                <div 
                  class="progress-bar-fill" 
                  style={`width: ${cat.total > 0 ? Math.round((cat.completed / cat.total) * 100) : 0}%;`}
                ></div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}
    
    <!-- Recent Activity -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-6" style="color: var(--color-text);">
        📋 Actividad Reciente
      </h2>
      
      <div class="card">
        <div class="space-y-2">
          {recentActivity.map((activity: any, index: number) => (
            <div class="activity-item" class:list={[{ 'border-b border-solid': index < recentActivity.length - 1 }]} style={index < recentActivity.length - 1 ? 'border-color: var(--color-border);' : ''}>
              <div class="activity-icon">
                {activity.icon}
              </div>
              <div class="flex-1">
                <p class="text-sm font-medium" style="color: var(--color-text);">
                  {activity.activity}
                </p>
                <p class="text-xs capitalize" style="color: var(--color-text-muted);">
                  {activity.program}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Quick Stats Grid -->
    <section class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-12">
      <div class="card text-center py-6">
        <div class="text-3xl mb-2">🐧</div>
        <div class="text-2xl font-bold" style="color: var(--color-accent);">{(programs as any).linux?.completed ?? 0}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">Linux Retos</div>
      </div>
      <div class="card text-center py-6">
        <div class="text-3xl mb-2">🐳</div>
        <div class="text-2xl font-bold" style="color: var(--color-accent);">{(programs as any).docker?.completed ?? 0}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">Docker Retos</div>
      </div>
      <div class="card text-center py-6">
        <div class="text-3xl mb-2">⚙️</div>
        <div class="text-2xl font-bold" style="color: var(--color-accent);">{(programs as any).devops?.completed ?? 0}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">DevOps Días</div>
      </div>
      <div class="card text-center py-6">
        <div class="text-3xl mb-2">🚩</div>
        <div class="text-2xl font-bold" style="color: var(--color-accent);">{(programs as any).ctf?.completed ?? overview.ctfCompleted}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">CTF Flags</div>
      </div>
      <div class="card text-center py-6">
        <div class="text-3xl mb-2">🎯</div>
        <div class="text-2xl font-bold" style="color: var(--color-accent);">{(programs as any).htb?.completed ?? 0}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">HTB Retos</div>
      </div>
    </section>
    
    <!-- Certifications Section - Cards -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-6" style="color: var(--color-text);">
        🏆 Certificaciones Obtenidas
      </h2>
      
      <div class="cert-cards-grid">
        <!-- Docker Certification Card -->
        <div class="cert-card" onclick="openCertModal('docker')">
          <div class="cert-card-badge">100/100</div>
          <div class="cert-card-icon">🐳</div>
          <h3 class="cert-card-title">Docker Certification</h3>
          <p class="cert-card-platform">KodeKloud Engineer</p>
          <div class="cert-card-meta">
            <span class="cert-card-date">📅 18-02-2026</span>
            <span class="cert-card-challenges">✅ 9/9 Challenges</span>
          </div>
          <div class="cert-card-verify">
            <span class="verify-icon">🔍</span>
            <span>Click para ver certificado</span>
          </div>
        </div>
      </div>
    </section>
    
  </div>
  
  <!-- Certificate Modal -->
  <div id="cert-modal" class="cert-modal">
    <div class="cert-modal-overlay" onclick="closeCertModal()"></div>
    <div class="cert-modal-content">
      <div class="cert-modal-header">
        <h3 id="cert-modal-title" class="cert-modal-title">Certificado</h3>
        <button class="cert-modal-close" onclick="closeCertModal()" title="Cerrar">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="cert-modal-body">
        <div class="cert-watermark">CERTIFICADO VERIFICADO</div>
        <img id="cert-modal-image" src="" alt="Certificate" class="cert-modal-image" />
      </div>
      <div class="cert-modal-footer">
        <a id="cert-modal-verify" href="#" target="_blank" class="cert-modal-btn primary">
          🔍 Verificar Autenticidad
        </a>
        <div class="cert-modal-id">
          <span>ID: </span>
          <code id="cert-modal-id-value"></code>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  const certifications = {
    docker: {
      title: 'Docker Certification - KodeKloud Engineer',
      image: '/certificates/kodekloud-docker-certificate.png',
      verifyUrl: 'https://engineer.kodekloud.com/certificate-verification/86476a89-ea7b-4e3a-a901-85cec28a00ca',
      id: '86476a89-ea7b-4e3a-a901-85cec28a00ca'
    }
  };

  function openCertModal(certKey) {
    const cert = certifications[certKey];
    if (!cert) return;
    
    const modal = document.getElementById('cert-modal');
    const title = document.getElementById('cert-modal-title');
    const image = document.getElementById('cert-modal-image');
    const verifyLink = document.getElementById('cert-modal-verify');
    const idValue = document.getElementById('cert-modal-id-value');
    
    if (title) title.textContent = cert.title;
    if (image) image.src = cert.image;
    if (verifyLink) verifyLink.href = cert.verifyUrl;
    if (idValue) idValue.textContent = cert.id;
    
    if (modal) {
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeCertModal() {
    const modal = document.getElementById('cert-modal');
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeCertModal();
    }
  });

  window.openCertModal = openCertModal;
  window.closeCertModal = closeCertModal;
</script>

<style>
  /* Animación para las cards */
  .card {
    animation: fadeIn 0.3s ease-out;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Line clamp for description */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* Badge colors por programa */
  :global(.badge-linux) {
    background-color: rgba(249, 115, 22, 0.2);
    color: #f97316;
  }
  
  :global(.badge-docker) {
    background-color: rgba(59, 130, 246, 0.2);
    color: #3b82f6;
  }
  
  :global(.badge-devops) {
    background-color: rgba(168, 85, 247, 0.2);
    color: #a855f7;
  }
  
  :global(.badge-htb) {
    background-color: rgba(16, 185, 129, 0.2);
    color: #10b981;
  }
  
  :global(.badge-ctf) {
    background-color: rgba(34, 197, 94, 0.2);
    color: #22c55e;
  }
  
  /* Certification Cards Grid */
  .cert-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  
  .cert-card {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.9) 0%, rgba(15, 23, 42, 0.95) 100%);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 1rem;
    padding: 1.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .cert-card:hover {
    border-color: rgba(59, 130, 246, 0.6);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px -12px rgba(59, 130, 246, 0.3);
  }
  
  .cert-card-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    border-radius: 2rem;
  }
  
  .cert-card-icon {
    font-size: 3rem;
    margin-bottom: 0.75rem;
  }
  
  .cert-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.25rem 0;
  }
  
  .cert-card-platform {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin: 0 0 1rem 0;
  }
  
  .cert-card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  
  .cert-card-verify {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #3b82f6;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(71, 85, 105, 0.3);
  }
  
  .verify-icon {
    font-size: 1rem;
  }
  
  /* Certificate Modal */
  .cert-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  
  .cert-modal.active {
    display: flex;
  }
  
  .cert-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
  }
  
  .cert-modal-content {
    position: relative;
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border: 1px solid rgba(59, 130, 246, 0.4);
    border-radius: 1rem;
    max-width: 900px;
    width: 100%;
    max-height: 90vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }
  
  .cert-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(71, 85, 105, 0.3);
    background: rgba(30, 41, 59, 0.5);
  }
  
  .cert-modal-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }
  
  .cert-modal-close {
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 0.5rem;
    padding: 0.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .cert-modal-close:hover {
    background: rgba(239, 68, 68, 0.3);
  }
  
  .cert-modal-close svg {
    width: 1.25rem;
    height: 1.25rem;
    color: #ef4444;
  }
  
  .cert-modal-body {
    flex: 1;
    overflow: auto;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
  }
  
  .cert-watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-30deg);
    font-size: 3rem;
    font-weight: 900;
    color: rgba(59, 130, 246, 0.1);
    white-space: nowrap;
    pointer-events: none;
    z-index: 1;
    letter-spacing: 0.5rem;
  }
  
  .cert-modal-image {
    max-width: 100%;
    max-height: 60vh;
    border-radius: 0.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    pointer-events: none;
    position: relative;
    z-index: 2;
  }
  
  .cert-modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid rgba(71, 85, 105, 0.3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    background: rgba(30, 41, 59, 0.5);
  }
  
  .cert-modal-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  
  .cert-modal-btn.primary {
    background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
    color: white;
  }
  
  .cert-modal-btn.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
  }
  
  .cert-modal-id {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  
  .cert-modal-id code {
    font-family: SF Mono, Monaco, monospace;
    color: #06b6d4;
    background: rgba(6, 182, 212, 0.1);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.7rem;
  }
  
  /* Disable right-click on modal */
  .cert-modal-body::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 10;
  }
</style>

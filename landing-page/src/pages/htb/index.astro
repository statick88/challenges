---
import MainLayout from '../../layouts/MainLayout.astro';
import allChallenges from '../../data/all-challenges.json';

const challenges = allChallenges.htb;

// Estadísticas
const completed = challenges.filter(c => c.status === 'completed').length;
const inProgress = challenges.filter(c => c.status === 'in_progress').length;
const blocked = challenges.filter(c => c.status === 'blocked').length;
const ready = challenges.filter(c => c.status === 'ready').length;
const total = challenges.length;
const percentage = total > 0 ? Math.round((completed / total) * 100) : 0;

// Configuración de categorías HTB
const categoryIcons = {
  'network-enum': '🎯',
  'crypto': '🔐',
  'web-security': '🌐',
  'forensics': '🔍',
  'privilege-escalation': '⬆️',
  'active-directory': '🏢'
};

const categoryColors = {
  'network-enum': 'border-teal-500/50 hover:border-teal-400',
  'crypto': 'border-violet-500/50 hover:border-violet-400',
  'web-security': 'border-cyan-500/50 hover:border-cyan-400',
  'forensics': 'border-amber-500/50 hover:border-amber-400',
  'privilege-escalation': 'border-orange-500/50 hover:border-orange-400',
  'active-directory': 'border-blue-500/50 hover:border-blue-400'
};

// Agrupar por categoría
const byCategory = challenges.reduce((acc, c) => {
  const cat = c.category || 'other';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(c);
  return acc;
}, {});
---

<MainLayout title="HTB Academy - Hack The Box">
  <div class="container mx-auto px-4 py-8">
    
    <!-- Header -->
    <div class="mb-8">
      <nav class="flex items-center gap-2 text-sm mb-4" style="color: var(--color-text-secondary);">
        <a href="/challenges/" class="hover:underline" style="color: var(--color-accent);">Dashboard</a>
        <span>/</span>
        <span>HTB</span>
      </nav>
      
      <div class="flex items-center gap-4 mb-4">
        <span class="text-5xl">🎯</span>
        <div>
          <h1 class="text-3xl font-bold" style="color: var(--color-text);">HTB Academy</h1>
          <p style="color: var(--color-text-secondary);">Hack The Box - Cybersecurity challenges with professional methodology</p>
        </div>
      </div>
    </div>
    
    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
      <div class="card text-center py-4">
        <div class="text-2xl font-bold" style="color: var(--color-accent);">{total}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">Total</div>
      </div>
      <div class="card text-center py-4">
        <div class="text-2xl font-bold text-emerald-400">{completed}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">Completados</div>
      </div>
      <div class="card text-center py-4">
        <div class="text-2xl font-bold text-amber-400">{inProgress}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">En Progreso</div>
      </div>
      <div class="card text-center py-4">
        <div class="text-2xl font-bold text-rose-400">{blocked}</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">Bloqueados</div>
      </div>
      <div class="card text-center py-4">
        <div class="text-2xl font-bold" style="color: var(--color-accent);">{percentage}%</div>
        <div class="text-xs" style="color: var(--color-text-secondary);">Progreso</div>
      </div>
    </div>
    
    <!-- Progress Bar -->
    <div class="mb-6">
      <div class="progress-bar" style="height: 10px;">
        <div class="progress-bar-fill" style={`width: ${percentage}%; background: linear-gradient(90deg, #14b8a6, #06b6d4);`}></div>
      </div>
    </div>
    
    <!-- Filter Bar -->
    <div class="filter-bar flex flex-wrap gap-2 mb-8">
      <button class="filter-btn active" data-filter="all" data-category="htb">
        Todos ({total})
      </button>
      <button class="filter-btn" data-filter="completed" data-category="htb">
        Completados ✓ ({completed})
      </button>
      <button class="filter-btn" data-filter="in_progress" data-category="htb">
        En Progreso ◐ ({inProgress})
      </button>
      <button class="filter-btn" data-filter="blocked" data-category="htb">
        Bloqueados ⊘ ({blocked})
      </button>
      <button class="filter-btn" data-filter="ready" data-category="htb">
        Pendientes ○ ({ready})
      </button>
    </div>
    
    <!-- Category Filter -->
    <div class="flex flex-wrap gap-2 mb-8">
      {Object.entries(byCategory).map(([cat, items]) => (
        <span class={`px-4 py-2 rounded-lg text-sm font-medium border ${categoryColors[cat] || categoryColors.other}`} style="background: rgba(30, 41, 59, 0.5);">
          {categoryIcons[cat] || '📄'} {cat} ({items.length})
        </span>
      ))}
    </div>
    
    <!-- Challenges by Category -->
    {Object.entries(byCategory).map(([category, categoryChallenges]) => (
      <section class="mb-12 category-section" data-category={category}>
        <div class="flex items-center gap-3 mb-4">
          <span class="text-2xl">{categoryIcons[category] || '📄'}</span>
          <h2 class="text-xl font-bold capitalize" style="color: var(--color-text);">
            {category}
          </h2>
          <span class="text-sm px-2 py-1 rounded" style="color: var(--color-text-muted); background: var(--color-bg-hover);">
            {categoryChallenges.filter((c) => c.status === 'completed').length}/{categoryChallenges.length}
          </span>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {categoryChallenges.map((challenge) => {
            const difficultyConfig = {
              easy: { stars: '⭐', color: 'text-emerald-400 bg-emerald-500/10', label: 'Fácil' },
              medium: { stars: '⭐⭐', color: 'text-amber-400 bg-amber-500/10', label: 'Medio' },
              hard: { stars: '⭐⭐⭐', color: 'text-rose-400 bg-rose-500/10', label: 'Difícil' }
            };
            const diff = difficultyConfig[challenge.difficulty] || difficultyConfig.medium;
            const statusColors = {
              completed: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40',
              in_progress: 'bg-amber-500/20 text-amber-400 border-amber-500/40',
              blocked: 'bg-rose-500/20 text-rose-400 border-rose-500/40',
              ready: 'bg-sky-500/20 text-sky-400 border-sky-500/40'
            };
            const statusLabels = {
              completed: 'Completado',
              in_progress: 'En Progreso',
              blocked: 'Bloqueado',
              ready: 'Pendiente'
            };
            const statusIcons = {
              completed: '✓',
              in_progress: '◐',
              blocked: '⊘',
              ready: '○'
            };
            const statusColor = statusColors[challenge.status] || statusColors.ready;
            const statusLabel = statusLabels[challenge.status] || 'Pendiente';
            const statusIcon = statusIcons[challenge.status] || '○';
            
            return (
              <div class="challenge-card group cursor-pointer" data-status={challenge.status} data-challenge-path={challenge.path} data-challenge-title={challenge.title} data-challenge-completed={challenge.status === "completed" ? "true" : "false"} onclick="openChallengeModal(this)">
                <!-- Header with status -->
                <div class="challenge-card-header">
                  <span class={`difficulty-badge ${diff.color}`}>
                    {diff.stars} {diff.label}
                  </span>
                  <span class={`status-badge ${statusColor}`}>
                    <span class="status-icon">{statusIcon}</span>
                    {statusLabel}
                  </span>
                </div>
                
                <!-- Title -->
                <h3 class="challenge-title">
                  {challenge.title}
                </h3>
                
                <!-- Scenario -->
                {challenge.scenario && (
                  <p class="challenge-scenario">
                    {challenge.scenario}
                  </p>
                )}
                
                <!-- Skills -->
                {challenge.skills && challenge.skills.length > 0 && (
                  <div class="challenge-skills">
                    {challenge.skills.slice(0, 4).map((skill, idx) => (
                      <span class={`skill-tag bg-teal-500/20 text-teal-300 border-teal-500/30`}>
                        {skill}
                      </span>
                    ))}
                  </div>
                )}
                
                <!-- Footer -->
                <div class="challenge-footer">
                  <div class="flex items-center gap-3 text-xs" style="color: var(--color-text-muted);">
                    {challenge.timeEstimate && (
                      <span class="flex items-center gap-1">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        {challenge.timeEstimate}
                      </span>
                    )}
                    <span>{challenge.date || 'Sin fecha'}</span>
                  </div>
                  
                  <a href={challenge.path} class="view-solution-btn group-hover:scale-105">
                    Ver Writeup
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    ))}
    
  </div>

  <!-- Challenge Modal -->
  <div id="challenge-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/80" onclick="closeChallengeModal()"></div>
    <div class="absolute inset-4 md:inset-8 lg:inset-12 bg-slate-900 rounded-xl overflow-hidden flex flex-col">
      <div class="flex items-center justify-between p-4 border-b border-slate-700 bg-slate-800">
        <h2 id="modal-title" class="text-xl font-bold text-white">Challenge</h2>
        <button onclick="closeChallengeModal()" class="p-2 hover:bg-slate-700 rounded-lg transition-colors">
          <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="flex-1 overflow-hidden relative">
        <iframe id="challenge-iframe" class="w-full h-full border-0" src=""></iframe>
        <a id="solution-link" href="#" class="hidden absolute bottom-6 right-6 bg-emerald-600 hover:bg-emerald-500 text-white px-6 py-3 rounded-lg font-semibold shadow-lg transition-all hover:scale-105 flex items-center gap-2">
          <span>Ver Solución Completa</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .challenge-card {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.9) 100%);
    border: 1px solid rgba(71, 85, 105, 0.3);
    border-radius: 1rem;
    padding: 1.25rem;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .challenge-card:hover {
    border-color: rgba(20, 184, 166, 0.5);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px -12px rgba(20, 184, 166, 0.25);
  }

  .challenge-card.hidden {
    display: none;
  }

  .challenge-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .difficulty-badge {
    font-size: 0.7rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    font-weight: 500;
  }

  .status-badge {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.7rem;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    border: 1px solid;
    font-weight: 500;
    white-space: nowrap;
  }

  .status-icon {
    font-size: 0.625rem;
  }

  .challenge-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #f1f5f9;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .challenge-scenario {
    font-size: 0.8rem;
    color: #94a3b8;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  .challenge-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .skill-tag {
    font-size: 0.65rem;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    border: 1px solid;
    font-weight: 500;
    text-transform: lowercase;
  }

  .challenge-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(71, 85, 105, 0.3);
    margin-top: auto;
  }

  .view-solution-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #14b8a6;
    padding: 0.5rem 0.875rem;
    background: rgba(20, 184, 166, 0.1);
    border-radius: 0.5rem;
    transition: all 0.2s ease;
  }

  .view-solution-btn:hover {
    background: rgba(20, 184, 166, 0.2);
  }

  .category-section.hidden {
    display: none;
  }

  .filter-btn {
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    background: rgba(30, 41, 59, 0.8);
    color: #94a3b8;
    border: 1px solid rgba(71, 85, 105, 0.3);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    background: rgba(51, 65, 85, 0.8);
    color: #e2e8f0;
  }

  .filter-btn.active {
    background: rgba(20, 184, 166, 0.2);
    color: #14b8a6;
    border-color: rgba(20, 184, 166, 0.5);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.challenge-card');
    const sections = document.querySelectorAll('.category-section');
    
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        const filter = btn.getAttribute('data-filter');
        
        cards.forEach(card => {
          const status = card.getAttribute('data-status');
          if (filter === 'all' || status === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });

        sections.forEach(section => {
          const sectionCards = section.querySelectorAll('.challenge-card:not(.hidden)');
          if (sectionCards.length === 0 && filter !== 'all') {
            section.classList.add('hidden');
          } else {
            section.classList.remove('hidden');
          }
        });
      });
    });
  });

  function openChallengeModal(card) {
    const modal = document.getElementById('challenge-modal');
    const iframe = document.getElementById('challenge-iframe');
    const title = document.getElementById('modal-title');
    const solutionLink = document.getElementById('solution-link');
    
    const path = card.getAttribute('data-challenge-path');
    const challengeTitle = card.getAttribute('data-challenge-title');
    const isCompleted = card.getAttribute('data-challenge-completed') === 'true';
    
    title.textContent = challengeTitle;
    iframe.src = path + '/';
    
    if (isCompleted) {
      solutionLink.href = path + '/';
      solutionLink.classList.remove('hidden');
    } else {
      solutionLink.classList.add('hidden');
    }
    
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeChallengeModal() {
    const modal = document.getElementById('challenge-modal');
    const iframe = document.getElementById('challenge-iframe');
    
    modal.classList.add('hidden');
    iframe.src = '';
    document.body.style.overflow = '';
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeChallengeModal();
    }
  });

  window.openChallengeModal = openChallengeModal;
  window.closeChallengeModal = closeChallengeModal;
</script>

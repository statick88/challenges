{
  "name": "challenges-dashboard",
  "type": "module",
  "version": "1.0.0",
  "description": "Interactive dashboard for technical challenges progress",
  "scripts": {
    "dev": "node scripts/generate-challenges-data.js && astro dev",
    "start": "astro dev",
    "build": "node scripts/generate-challenges-data.js && astro build",
    "preview": "astro preview",
    "parse-data": "node scripts/generate-challenges-data.js",
    "astro": "astro",
    "validate": "node scripts/validation/validate-structure.js",
    "validate:frontmatter": "node scripts/validation/validate-frontmatter.js",
    "validate:consistency": "node scripts/validation/validate-consistency.js",
    "validate:health": "node scripts/validation/health-check.js",
    "validate:all": "npm run parse-data && npm run validate && npm run validate:frontmatter && npm run validate:consistency && npm run validate:health"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.0",
    "marked": "^17.0.1",
    "puppeteer": "^24.36.1",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/node": "^9.5.2",
    "@types/node": "^20.0.0",
    "astro": "^5.17.1",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.12.0"
  },
  "keywords": [
    "astro",
    "tailwindcss",
    "dashboard",
    "challenges",
    "devops"
  ],
  "author": "Diego Saavedra",
  "license": "MIT",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statick88/challenges.git"
  },
  "bugs": {
    "url": "https://github.com/statick88/challenges/issues"
  },
  "homepage": "https://github.com/statick88/challenges#readme"
}
